  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u043E\u043A\u0430\u0436\u0443, \u043A\u0443\u0434\u0430 \u0438\u0445
      \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C."
    Object: {fileID: 0}
  - Language: English
    Text: I will show you where to spend them.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041F\u043E\u043A\u0430\u0436\u0443, \u043A\u0443\u0434\u0438 \u0457\u0445
      \u043C\u043E\u0436\u043D\u0430 \u0432\u0438\u0442\u0440\u0430\u0442\u0438\u0442\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Te ense\xF1ar\xE9 d\xF3nde gastarlos."
    Object: {fileID: 0}
