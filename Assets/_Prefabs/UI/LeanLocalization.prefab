--- !u!114 &900000000000000087
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000085}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0414\u0430\u0432\u0430\u0439 \u0437\u0430\u0439\u0434\u0451\u043C \u0432
      \u043C\u0430\u0433\u0430\u0437\u0438\u043D, \u043A\u0443\u043F\u0438\u043C
      \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432 \u0438 \u0434\u043E\u0441\u0442\u0440\u043E\u0438\u043C
      \u044D\u0442\u0443 \u043F\u043B\u0430\u043D\u0435\u0442\u0443. \u0423 \u043C\u0435\u043D\u044F
      \u0443\u0436\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0437\u0430\u043A\u0430\u0437
      \u043F\u044B\u043B\u0438\u0442\u0441\u044F."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0414\u0430\u0432\u0430\u0439 \u0437\u0430\u0439\u0434\u0435\u043C\u043E
      \u0434\u043E \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0443, \u043A\u0443\u043F\u0438\u043C\u043E
      \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u0456 \u0434\u043E\u0431\u0443\u0434\u0443\u0454\u043C\u043E
      \u0446\u044E \u043F\u043B\u0430\u043D\u0435\u0442\u0443. \u041D\u0430\u0441\u0442\u0443\u043F\u043D\u0435
      \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0432\u0436\u0435
      \u043F\u0440\u0438\u043F\u0430\u0434\u0430\u0454 \u043F\u0438\u043B\u043E\u043C."
    Object: {fileID: 0}
  - Language: English
    Text: Let's head to the store, buy some resources, and finish this planet. My
      next contract is already gathering dust.
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Vamos a la tienda, compramos recursos y terminamos este planeta. El siguiente
      encargo ya est\xE1 acumulando polvo."
    Object: {fileID: 0}
