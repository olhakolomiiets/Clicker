  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041C\u043E\u043D\u0435\u0442 \u0443\u0436\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0434\u043B\u044F \u043D\u043E\u0432\u043E\u0433\u043E \u043E\u0431\u044A\u0435\u043A\u0442\u0430.
      \u0417\u0430\u0433\u043B\u044F\u043D\u0438 \u0432 \xAB\u0422\u0432\u043E\u0440\u0435\u043D\u0438\u0435\xBB."
    Object: {fileID: 0}
  - Language: English
    Text: You have enough coins for a new object. Check out Creation.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041C\u043E\u043D\u0435\u0442 \u0443\u0436\u0435 \u0432\u0438\u0441\u0442\u0430\u0447\u0430\u0454
      \u043D\u0430 \u043D\u043E\u0432\u0438\u0439 \u043E\u0431\u2019\u0454\u043A\u0442.
      \u0417\u0430\u0437\u0438\u0440\u043D\u0438 \u0432 \xAB\u0422\u0432\u043E\u0440\u0435\u043D\u043D\u044F\xBB."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Ya tienes monedas suficientes para un objeto nuevo. Visita Creaci\xF3n."
    Object: {fileID: 0}
