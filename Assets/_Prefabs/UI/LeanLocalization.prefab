--- !u!114 &900000000000000042
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000040}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041A\u0430\u043A \u0442\u0430\u043C \u041C\u0435\u0442\u0430\u043F\u043B\u0430\u043D\u0435\u0442\u0430?
      \u041C\u044B \u0441\u0442\u0440\u043E\u0438\u043C \u043F\u043B\u0430\u043D\u0435\u0442\u044B
      \u043D\u0430 \u0437\u0430\u043A\u0430\u0437, \u0430 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u0445\u043E\u0436\u0430 \u043D\u0430
      \u0431\u0443\u043B\u044B\u0436\u043D\u0438\u043A."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u042F\u043A \u0442\u0430\u043C \u041C\u0435\u0442\u0430\u043F\u043B\u0430\u043D\u0435\u0442\u0430?
      \u041C\u0438 \u0431\u0443\u0434\u0443\u0454\u043C\u043E \u043F\u043B\u0430\u043D\u0435\u0442\u0438
      \u043D\u0430 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F,
      \u0430 \u043D\u0430\u0448\u0430 \u0432\u043B\u0430\u0441\u043D\u0430 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0441\u0445\u043E\u0436\u0430 \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u044E\u043A\u0443."
    Object: {fileID: 0}
  - Language: English
    Text: How's the Meta Planet doing? We build planets to order, but our own looks
      like a giant rock.
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xBFQu\xE9 tal va la Metaplaneta? Construimos planetas por encargo, pero
      el nuestro parece un pedrusco."
    Object: {fileID: 0}
