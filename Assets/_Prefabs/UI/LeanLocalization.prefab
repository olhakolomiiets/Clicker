  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041E\u043D\u0438 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442
      \u0432\u0441\u0435 \u0431\u0443\u0434\u0443\u0449\u0438\u0435 \u043F\u043B\u0430\u043D\u0435\u0442\u044B."
    Object: {fileID: 0}
  - Language: English
    Text: They give all future planets a boost.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0412\u043E\u043D\u0438 \u043F\u043E\u0441\u0438\u043B\u044E\u044E\u0442\u044C
      \u0443\u0441\u0456 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0456 \u043F\u043B\u0430\u043D\u0435\u0442\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Potencian todos los planetas futuros.
    Object: {fileID: 0}
