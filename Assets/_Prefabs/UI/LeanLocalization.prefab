--- !u!114 &8801000000000000017
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8801000000000000015}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name:
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0416\u0438\u0442\u0435\u043b\u0438 \u043f\u043b\u0430\u0442\u044f\u0442 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0443, \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u043b. \u041d\u0430\u0439\u0434\u0438\u0442\u0435 \u0441\u043f\u0440\u044f\u0442\u0430\u043d\u043d\u044b\u0435 \u0434\u0435\u043d\u044c\u0433\u0438 \u0438 \u043f\u043e\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0441\u043b\u043e\u043c\u0430\u0442\u044c."
    Object: {fileID: 0}
  - Language: English
    Text: "The locals pay the Professor to leave everything alone. Find the hidden money and try not to break anything."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041c\u0435\u0448\u043a\u0430\u043d\u0446\u0456 \u043f\u043b\u0430\u0442\u044f\u0442\u044c \u043f\u0440\u043e\u0444\u0435\u0441\u043e\u0440\u0443, \u0449\u043e\u0431 \u0432\u0456\u043d \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0447\u0456\u043f\u0430\u0432. \u0417\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u0441\u0445\u043e\u0432\u0430\u043d\u0456 \u0433\u0440\u043e\u0448\u0456 \u0439 \u043f\u043e\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044f \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0437\u043b\u0430\u043c\u0430\u0442\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Los habitantes pagan al Profesor para que no toque nada. Encuentra el dinero escondido y procura no romper nada."
    Object: {fileID: 0}
