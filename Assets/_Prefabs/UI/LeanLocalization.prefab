  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043E\u0447\u0435\u043D\u044C \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435."
    Object: {fileID: 0}
  - Language: English
    Text: Sometimes very strange ones.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0406\u043D\u043E\u0434\u0456 \u0434\u0443\u0436\u0435 \u0434\u0438\u0432\u043D\u0456."
    Object: {fileID: 0}
  - Language: Spanish
    Text: A veces, muy raros.
    Object: {fileID: 0}
