--- !u!114 &900000000000000018
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000016}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041D\u0430 \u043E\u0440\u0431\u0438\u0442\u0435 \u043D\u0430\u0448\u043B\u0438
      \u043A\u0430\u043A\u0438\u0435 \u0442\u043E \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u0435
      \u0448\u0442\u0443\u043A\u0438. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 \u0438 \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u0430\u043B\u043C\u0430\u0437\u044B?"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041D\u0430 \u043E\u0440\u0431\u0456\u0442\u0456 \u0437\u043D\u0430\u0439\u0448\u043B\u0438
      \u044F\u043A\u0456\u0441\u044C \u0431\u043B\u0438\u0441\u043A\u0443\u0447\u0456
      \u0448\u0442\u0443\u043A\u0438. \u041F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 \u0439 \u0437\u0430\u0431\u0435\u0440\u0435\u043C\u043E
      \u0430\u043B\u043C\u0430\u0437\u0438?"
    Object: {fileID: 0}
  - Language: English
    Text: They found some shiny things in orbit. Watch an ad and grab the diamonds?
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Han encontrado unas cosas brillantes en \xF3rbita. \xBFVemos un anuncio
      y recogemos los diamantes?"
    Object: {fileID: 0}
