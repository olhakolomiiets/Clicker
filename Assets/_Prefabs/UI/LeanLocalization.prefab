  m_GameObject: {fileID: 2369468277471912481}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043C
      \u043D\u043E\u0432\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442.\n\u041F\u043E\u043A\u0430
      \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u0440\u043E\u0431\u043A\u0430
      \u0441 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u043E\u0439.\n\u0421\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
      \u0443\u0437\u043D\u0430\u0435\u043C \u043F\u043E\u0441\u043B\u0435 \u0440\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u043A\u0438."
    Object: {fileID: 0}
  - Language: English
    Text: 'First, place a new object.

      For now it is just a delivery box.

      We
      will see what is inside after unpacking.'
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0421\u043F\u0435\u0440\u0448\u0443 \u0440\u043E\u0437\u043C\u0456\u0441\u0442\u0438\u043C\u043E
      \u043D\u043E\u0432\u0438\u0439 \u043E\u0431'\u0454\u043A\u0442.\n\u041F\u043E\u043A\u0438
      \u0449\u043E \u0446\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u043E\u0440\u043E\u0431\u043A\u0430
      \u0437 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u043E\u044E.\n\u0429\u043E
      \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456, \u0434\u0456\u0437\u043D\u0430\u0454\u043C\u043E\u0441\u044F
      \u043F\u0456\u0441\u043B\u044F \u0440\u043E\u0437\u043F\u0430\u043A\u0443\u0432\u0430\u043D\u043D\u044F."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Primero coloca un objeto nuevo.\nPor ahora es solo una caja de entrega.\nVeremos
      qu\xE9 hay dentro al abrirla."
    Object: {fileID: 0}
