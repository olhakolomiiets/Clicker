--- !u!114 &8069619127585732280
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6345133739816501143}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041D\u0430\u043A\u043E\u043F\u0438\u0448\u044C \u0434\u0435\u043D\u0435\u0433
      \u2014 \u043F\u0440\u0438\u0445\u043E\u0434\u0438. \u0412\u044B\u0436\u043C\u0435\u043C
      \u0438\u0437 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432 \u0435\u0449\u0451
      \u0431\u043E\u043B\u044C\u0448\u0435!"
    Object: {fileID: 0}
  - Language: English
    Text: Come back when you've saved up some money. We'll squeeze even more out
      of those trees!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041D\u0430\u0437\u0431\u0438\u0440\u0430\u0454\u0448 \u0433\u0440\u043E\u0448\u0435\u0439
      \u2014 \u043F\u0440\u0438\u0445\u043E\u0434\u044C. \u0412\u0438\u0447\u0430\u0432\u0438\u043C\u043E
      \u0437 \u0434\u0435\u0440\u0435\u0432 \u0456\u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Vuelve cuando hayas ahorrado algo de dinero. \xA1Les sacaremos a\xFAn
      m\xE1s a esos \xE1rboles!"
    Object: {fileID: 0}
