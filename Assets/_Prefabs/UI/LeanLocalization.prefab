--- !u!114 &900000000000000054
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000052}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0435
      \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0438\u044F \u0434\u043B\u044F
      \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432. \u041C\u043E\u0436\u0435\u0442,
      \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043C \u0445\u043E\u0442\u044F \u0431\u044B
      \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043D\u0430 \u043D\u0430\u0448\u0435\u0439
      \u043F\u043B\u0430\u043D\u0435\u0442\u0435?"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E \u0442\u0438\u0436\u043D\u044F
      \u043F\u0440\u0435\u0437\u0435\u043D\u0442\u0430\u0446\u0456\u044F \u0434\u043B\u044F
      \u043A\u043B\u0456\u0454\u043D\u0442\u0456\u0432. \u041C\u043E\u0436\u0435,
      \u0437\u0431\u0443\u0434\u0443\u0454\u043C\u043E \u043D\u0430 \u043D\u0430\u0448\u0456\u0439
      \u043F\u043B\u0430\u043D\u0435\u0442\u0456 \u0445\u043E\u0447 \u0449\u043E\u0441\u044C?"
    Object: {fileID: 0}
  - Language: English
    Text: We've got a client presentation next week. Think we could build at least
      something on our planet?
    Object: {fileID: 0}
  - Language: Spanish
    Text: "La semana que viene tenemos una presentaci\xF3n para clientes. \xBFY si
      construimos al menos algo en nuestro planeta?"
    Object: {fileID: 0}
