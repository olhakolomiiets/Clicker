--- !u!114 &8900000000000000041
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8900000000000000039}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u043E\u0445\u043E\u0436\u0435, \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u0442\u0430\u0439\u043D\u0438\u043A! \u041F\u043E\u043A\u0440\u0443\u0442\u0438
      \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u0438 \u043F\u043E\u0438\u0449\u0438
      \u0441\u0443\u043D\u0434\u0443\u043A."
    Object: {fileID: 0}
  - Language: English
    Text: Looks like a secret stash has appeared! Rotate the planet and look for
      a chest.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0421\u0445\u043E\u0436\u0435, \u0442\u0443\u0442 \u0437\u2019\u044F\u0432\u0438\u043B\u0430\u0441\u044F
      \u0441\u0445\u043E\u0432\u0430\u043D\u043A\u0430! \u041F\u043E\u043A\u0440\u0443\u0442\u0438
      \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u0439 \u043F\u043E\u0448\u0443\u043A\u0430\u0439
      \u0441\u043A\u0440\u0438\u043D\u044E."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Parece que ha aparecido un escondite! Gira el planeta y busca un cofre."
    Object: {fileID: 0}
