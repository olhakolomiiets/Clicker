--- !u!114 &1149929985203689087
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 998651555909727479}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u0444\u0438\u0441
      \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043C \u043F\u043E\u0441\u043B\u0435
      \u043F\u0435\u0440\u0432\u044B\u0445 \u0437\u0430\u043A\u0430\u0437\u043E\u0432."
    Object: {fileID: 0}
  - Language: English
    Text: We'll build a separate office after our first orders.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041E\u043A\u0440\u0435\u043C\u0438\u0439 \u043E\u0444\u0456\u0441 \u0437\u0431\u0443\u0434\u0443\u0454\u043C\u043E
      \u043F\u0456\u0441\u043B\u044F \u043F\u0435\u0440\u0448\u0438\u0445 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u044C."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Construiremos una oficina aparte despu\xE9s de los primeros encargos."
    Object: {fileID: 0}
