--- !u!114 &3602656638313214188
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7506341927824502715}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0411\u043E\u043D\u0443\u0441 \u0434\u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u0432\u0441\u0435\u043C \u0431\u0443\u0434\u0443\u0449\u0438\u043C \u043F\u043B\u0430\u043D\u0435\u0442\u0430\u043C.
      \u0412\u043E\u0442 \u044D\u0442\u043E \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044F!"
    Object: {fileID: 0}
  - Language: English
    Text: All future planets get the bonus. Now that's an investment!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0411\u043E\u043D\u0443\u0441 \u0434\u0456\u0441\u0442\u0430\u043D\u0435\u0442\u044C\u0441\u044F
      \u0432\u0441\u0456\u043C \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0456\u043C
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430\u043C. \u041E\u0446\u0435 \u0456\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0456\u044F!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Todos los planetas futuros recibir\xE1n la bonificaci\xF3n. \xA1Eso s\xED
      que es una inversi\xF3n!"
    Object: {fileID: 0}
