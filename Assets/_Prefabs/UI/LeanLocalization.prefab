--- !u!114 &7126729987203598184
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7704839356141222367}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0410 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u043D\u0430
      Meta Planet \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044C \u0432\u0441\u0435 \u0431\u0443\u0434\u0443\u0449\u0438\u0435
      \u043C\u0438\u0440\u044B."
    Object: {fileID: 0}
  - Language: English
    Text: And Meta Planet upgrades help every future world grow faster.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0410 \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u044F \u043D\u0430
      Meta Planet \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u044E\u0442\u044C
      \u0448\u0432\u0438\u0434\u0448\u0435 \u0440\u043E\u0437\u0432\u0438\u0432\u0430\u0442\u0438
      \u0432\u0441\u0456 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0456 \u0441\u0432\u0456\u0442\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Y las mejoras de Meta Planet ayudan a todos los mundos futuros a crecer
      m\xE1s r\xE1pido."
    Object: {fileID: 0}
