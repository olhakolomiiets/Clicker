  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0425\u043E\u0442\u044F \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435
      \u0434\u043E\u043C\u0430 \u0442\u043E\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u0438."
    Object: {fileID: 0}
  - Language: English
    Text: Though pretty houses are nice too.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0425\u043E\u0447\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u0456 \u0431\u0443\u0434\u0438\u043D\u043A\u0438
      \u0442\u0435\u0436 \u0445\u043E\u0440\u043E\u0448\u0456."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Aunque las casas bonitas tambi\xE9n ayudan."
    Object: {fileID: 0}
