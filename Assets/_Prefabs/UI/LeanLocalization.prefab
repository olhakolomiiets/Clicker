--- !u!114 &900000000000000090
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000088}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u043E\u0439\u0434\u0451\u043C \u043A\u0443\u043F\u0438\u043C \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432.
      \u041A\u043B\u0438\u0435\u043D\u0442\u0443 \u044F \u0443\u0436\u0435 \u0442\u0440\u0438
      \u0440\u0430\u0437\u0430 \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u043F\u043E\u0447\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u0430."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0425\u043E\u0434\u0456\u043C\u043E \u043A\u0443\u043F\u0438\u043C\u043E
      \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432. \u042F \u0432\u0436\u0435
      \u0442\u0440\u0438\u0447\u0456 \u043A\u0430\u0437\u0430\u0432 \u043A\u043B\u0456\u0454\u043D\u0442\u0443,
      \u0449\u043E \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u043C\u0430\u0439\u0436\u0435
      \u0433\u043E\u0442\u043E\u0432\u0430."
    Object: {fileID: 0}
  - Language: English
    Text: Let's go buy some resources. I've already told the client three times that
      the planet is almost finished.
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Vamos a comprar recursos. Ya le he dicho al cliente tres veces que el
      planeta est\xE1 casi terminado."
    Object: {fileID: 0}
