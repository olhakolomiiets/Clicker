--- !u!114 &900000000000000084
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000082}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u042F \u043D\u0430\u0448\u0451\u043B \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0430
      \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u0432\u0430\u043B\u044E\u0442\u044B.
      \u041D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043C\u0430\u0433\u0430\u0437\u0438\u043D.
      \u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u0434\u043E\u0431\u043D\u043E."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u042F \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u043F\u043E\u0441\u0442\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430
      \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0457 \u0432\u0430\u043B\u044E\u0442\u0438.
      \u041D\u0430\u0437\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F \xAB\u043C\u0430\u0433\u0430\u0437\u0438\u043D\xBB.
      \u041F\u0456\u0434\u043E\u0437\u0440\u0456\u043B\u043E \u0437\u0440\u0443\u0447\u043D\u043E."
    Object: {fileID: 0}
  - Language: English
    Text: I found a supplier of local currency. It's called the store. Suspiciously
      convenient.
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Encontr\xE9 un proveedor de moneda local. Se llama \xABla tienda\xBB.
      Sospechosamente pr\xE1ctico."
    Object: {fileID: 0}
