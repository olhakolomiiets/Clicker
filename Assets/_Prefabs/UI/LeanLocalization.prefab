  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0421\u0432\u043E\u0438 \u0436\u0438\u0442\u0435\u043B\u0438."
    Object: {fileID: 0}
  - Language: English
    Text: Its own people.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0421\u0432\u043E\u0457\u0445 \u0436\u0438\u0442\u0435\u043B\u0456\u0432."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Sus propios habitantes.
    Object: {fileID: 0}
