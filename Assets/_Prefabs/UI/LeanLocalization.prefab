--- !u!114 &900000000000000063
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000061}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0414\u0430\u0432\u0430\u0439 \u043A\u0443\u043F\u0438\u043C \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432
      \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 \u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043C
      \u0443\u0436\u0435 \u044D\u0442\u043E\u0442 \u0437\u0430\u043A\u0430\u0437.
      \u0423 \u043C\u0435\u043D\u044F \u043F\u0435\u043D\u0441\u0438\u044F \u043D\u0430
      \u043D\u043E\u0441\u0443."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0414\u0430\u0432\u0430\u0439 \u043A\u0443\u043F\u0438\u043C\u043E \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432
      \u0443 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456 \u0439 \u043D\u0430\u0440\u0435\u0448\u0442\u0456
      \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043C\u043E \u0446\u0435 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F.
      \u041C\u0435\u043D\u0456 \u0432\u0436\u0435 \u0447\u0430\u0441 \u043D\u0430
      \u043F\u0435\u043D\u0441\u0456\u044E."
    Object: {fileID: 0}
  - Language: English
    Text: Let's buy some resources in the store and finish this contract already.
      I'm about to retire.
    Object: {fileID: 0}
  - Language: Spanish
    Text: Vamos a comprar recursos en la tienda y terminar de una vez este encargo.
      Estoy a un paso de jubilarme.
    Object: {fileID: 0}
--- !u!1 &900000000000000064
