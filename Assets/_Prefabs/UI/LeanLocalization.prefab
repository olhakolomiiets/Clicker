  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0412\u043E\u0442 \u0438 \u043D\u0430\u0448\u0430 \u043F\u0435\u0440\u0432\u0430\u044F
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430. \u041F\u043E\u043A\u0430 \u0446\u0435\u043B\u0430\u044F!"
    Object: {fileID: 0}
  - Language: English
    Text: Here's our first planet. Still in one piece!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041E\u0441\u044C \u0456 \u043D\u0430\u0448\u0430 \u043F\u0435\u0440\u0448\u0430
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430. \u041F\u043E\u043A\u0438 \u0446\u0456\u043B\u0430!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Aqu\xED est\xE1 nuestro primer planeta! \xA1De momento sigue intacto!"
    Object: {fileID: 0}
