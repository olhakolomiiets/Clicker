--- !u!114 &900000000000000021
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000019}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0418\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u044B\u0439
      \u043A\u043B\u0438\u0435\u043D\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0447\u0430\u0435\u0432\u044B\u0435 \u0430\u043B\u043C\u0430\u0437\u0430\u043C\u0438.
      \u0417\u0430\u0431\u0440\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435 \u0440\u0435\u043A\u043B\u0430\u043C\u044B?"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0406\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u0438\u0439
      \u043A\u043B\u0456\u0454\u043D\u0442 \u0437\u0430\u043B\u0438\u0448\u0438\u0432
      \u0447\u0430\u0439\u043E\u0432\u0456 \u0430\u043B\u043C\u0430\u0437\u0430\u043C\u0438.
      \u0417\u0430\u0431\u0435\u0440\u0435\u043C\u043E \u043F\u0456\u0441\u043B\u044F
      \u0440\u0435\u043A\u043B\u0430\u043C\u0438?"
    Object: {fileID: 0}
  - Language: English
    Text: An alien client left a tip in diamonds. Watch an ad to collect it?
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Un cliente extraterrestre dej\xF3 una propina en diamantes. \xBFLa recogemos
      despu\xE9s de ver un anuncio?"
    Object: {fileID: 0}
