--- !u!114 &8801000000000000008
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8801000000000000006}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name:
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u042d\u0432\u043e\u043b\u044e\u0446\u0438\u044f \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u0430\u044f. \u041e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u2014 \u043d\u0435\u0442. \u0416\u0438\u0442\u0435\u043b\u0438 \u0441\u043f\u0440\u044f\u0442\u0430\u043b\u0438 \u0441\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u043e\u0431\u0440\u043e\u043a. \u041d\u0430\u0439\u0434\u0438\u0442\u0435 \u0435\u0433\u043e \u0438 \u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435."
    Object: {fileID: 0}
  - Language: English
    Text: "Evolution is free. Maintenance isn't. The locals hid the tribute they collected. Find it and claim it."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0415\u0432\u043e\u043b\u044e\u0446\u0456\u044f \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0430. \u041e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u2014 \u043d\u0456. \u041c\u0435\u0448\u043a\u0430\u043d\u0446\u0456 \u0441\u0445\u043e\u0432\u0430\u043b\u0438 \u0437\u0456\u0431\u0440\u0430\u043d\u0443 \u0434\u0430\u043d\u0438\u043d\u0443. \u0417\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u0457\u0457 \u0442\u0430 \u0437\u0430\u0431\u0435\u0440\u0456\u0442\u044c."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "La evoluci\u00f3n es gratis. El mantenimiento no. Los habitantes escondieron el tributo recaudado. Encu\u00e9ntralo y rec\u00f3gelo."
    Object: {fileID: 0}
--- !u!1 &8801000000000000009
