  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Your creation will be able to generate income without your involvement
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0422\u0432\u043E\u0435 \u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435
      \u0441\u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C
      \u0434\u043E\u0445\u043E\u0434 \u0431\u0435\u0437 \u0442\u0432\u043E\u0435\u0433\u043E
      \u0443\u0447\u0430\u0441\u0442\u0438\u044F"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Tu creaci\xF3n podr\xE1 generar ingresos sin tu participaci\xF3n"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0432\u043E\u0454 \u0442\u0432\u043E\u0440\u0456\u043D\u043D\u044F
      \u0437\u043C\u043E\u0436\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0438
      \u0434\u043E\u0445\u0456\u0434 \u0431\u0435\u0437 \u0442\u0432\u043E\u0454\u0457
      \u0443\u0447\u0430\u0441\u0442\u0456"
    Object: {fileID: 0}
