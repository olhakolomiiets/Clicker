--- !u!114 &900000000000000075
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000073}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041C\u043E\u0436\u0435\u0442, \u043A\u0443\u043F\u0438\u043C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u0432\u0430\u043B\u044E\u0442\u044B?
      \u042F \u0437\u043D\u0430\u044E \u043E\u0434\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430.
      \u041F\u0440\u0430\u0432\u0434\u0430, \u043E\u043D \u0442\u043E\u0436\u0435
      \u043C\u0435\u043D\u044F \u0437\u043D\u0430\u0435\u0442."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041C\u043E\u0436\u0435, \u043A\u0443\u043F\u0438\u043C\u043E \u0442\u0440\u043E\u0445\u0438
      \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0457 \u0432\u0430\u043B\u044E\u0442\u0438?
      \u042F \u0437\u043D\u0430\u044E \u043E\u0434\u043D\u043E\u0433\u043E \u0434\u0456\u043B\u043A\u0430.
      \u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430, \u0432\u0456\u043D \u0442\u0435\u0436
      \u043C\u0435\u043D\u0435 \u0437\u043D\u0430\u0454."
    Object: {fileID: 0}
  - Language: English
    Text: How about buying some local currency? I know a guy. Trouble is, he knows
      me too.
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xBFY si compramos algo de moneda local? Conozco a un tipo. Por desgracia,
      \xE9l tambi\xE9n me conoce."
    Object: {fileID: 0}
