--- !u!114 &900000000000000027
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000025}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0412 \u0430\u0441\u0442\u0435\u0440\u043E\u0438\u0434\u0435 \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0430
      \u043F\u043E\u0441\u044B\u043B\u043A\u0430 \u0441 \u0430\u043B\u043C\u0430\u0437\u0430\u043C\u0438.
      \u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u043E\u0441\u043B\u0435 \u0440\u0435\u043A\u043B\u0430\u043C\u044B?"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0412 \u0430\u0441\u0442\u0435\u0440\u043E\u0457\u0434\u0456 \u0437\u0430\u0441\u0442\u0440\u044F\u0433\u043B\u0430
      \u043F\u043E\u0441\u0438\u043B\u043A\u0430 \u0437 \u0430\u043B\u043C\u0430\u0437\u0430\u043C\u0438.
      \u0412\u0456\u0434\u043A\u0440\u0438\u0454\u043C\u043E \u043F\u0456\u0441\u043B\u044F
      \u0440\u0435\u043A\u043B\u0430\u043C\u0438?"
    Object: {fileID: 0}
  - Language: English
    Text: A package of diamonds is stuck inside an asteroid. Watch an ad to open
      it?
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Un paquete de diamantes se qued\xF3 atrapado en un asteroide. \xBFLo abrimos
      despu\xE9s de ver un anuncio?"
    Object: {fileID: 0}
--- !u!1 &900000000000000028
