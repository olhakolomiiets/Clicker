--- !u!114 &8900000000000000035
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8900000000000000033}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0425\u0432\u0430\u0442\u0438\u0442 \u0441\u0440\u0435\u0434\u0441\u0442\u0432
      \u0435\u0449\u0451 \u043D\u0430 \u043E\u0434\u043D\u0443 \u043A\u043E\u043F\u0438\u044E.
      \u0411\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432
      \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u043E\u0445\u043E\u0434\u0430!"
    Object: {fileID: 0}
  - Language: English
    Text: You can afford another copy. More objects mean more income!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041A\u043E\u0448\u0442\u0456\u0432 \u0432\u0438\u0441\u0442\u0430\u0447\u0430\u0454
      \u0449\u0435 \u043D\u0430 \u043E\u0434\u043D\u0443 \u043A\u043E\u043F\u0456\u044E.
      \u0411\u0456\u043B\u044C\u0448\u0435 \u043E\u0431\u2019\u0454\u043A\u0442\u0456\u0432
      \u2014 \u0431\u0456\u043B\u044C\u0448\u0435 \u0434\u043E\u0445\u043E\u0434\u0443!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Te alcanza para otra copia. \xA1M\xE1s objetos significan m\xE1s ingresos!"
    Object: {fileID: 0}
