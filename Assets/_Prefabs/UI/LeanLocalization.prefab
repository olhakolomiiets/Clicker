  data: 0
  entries:
  - Language: English
    Text: You don't have enough coins to expand the universe
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0423 \u0432\u0430\u0441 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
