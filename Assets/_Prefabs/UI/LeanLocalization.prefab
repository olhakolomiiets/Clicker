--- !u!114 &900000000000000072
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000070}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u043E\u0439\u0434\u0451\u043C \u043A\u0443\u043F\u0438\u043C \u0430\u043B\u043C\u0430\u0437\u043E\u0432.
      \u0423 \u043C\u0435\u043D\u044F \u0431\u043E\u0440\u043E\u0434\u0430 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0440\u0430\u0441\u0442\u0451\u0442, \u0447\u0435\u043C \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u044D\u0442\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0425\u043E\u0434\u0456\u043C\u043E \u043A\u0443\u043F\u0438\u043C\u043E
      \u0430\u043B\u043C\u0430\u0437\u0456\u0432. \u041C\u043E\u044F \u0431\u043E\u0440\u043E\u0434\u0430
      \u0440\u043E\u0441\u0442\u0435 \u0448\u0432\u0438\u0434\u0448\u0435, \u043D\u0456\u0436
      \u0440\u043E\u0437\u0432\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F \u0446\u044F
      \u043F\u043B\u0430\u043D\u0435\u0442\u0430."
    Object: {fileID: 0}
  - Language: English
    Text: Let's go buy some diamonds. My beard is growing faster than this planet
      is developing.
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Vamos a comprar diamantes. Mi barba crece m\xE1s r\xE1pido de lo que evoluciona
      este planeta."
    Object: {fileID: 0}
