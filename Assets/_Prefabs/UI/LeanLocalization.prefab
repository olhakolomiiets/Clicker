--- !u!114 &4501598278660173141
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4838188076266992352}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0416\u0438\u0442\u044C \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0431\u0443\u0434\u0435\u043C \u0442\u0430\u043C \u0436\u0435. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F!"
    Object: {fileID: 0}
  - Language: English
    Text: We'll live and work there too. Talk about saving money!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0416\u0438\u0442\u0438 \u0439 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
      \u0431\u0443\u0434\u0435\u043C\u043E \u0442\u0430\u043C \u0441\u0430\u043C\u043E.
      \u0415\u043A\u043E\u043D\u043E\u043C\u0456\u044F!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Viviremos y trabajaremos all\xED mismo. \xA1Hay que ahorrar!"
    Object: {fileID: 0}
