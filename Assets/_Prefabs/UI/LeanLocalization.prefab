--- !u!114 &3909031629529857116
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8205595419732414756}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0417\u0434\u0435\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u044E\u0442\u0441\u044F
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u0434\u043B\u044F
      \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u043F\u043B\u0430\u043D\u0435\u0442."
    Object: {fileID: 0}
  - Language: English
    Text: This is where we build tech for future planets.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0443\u0442 \u043C\u0438 \u0441\u0442\u0432\u043E\u0440\u044E\u0454\u043C\u043E
      \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457 \u0434\u043B\u044F
      \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0456\u0445 \u043F\u043B\u0430\u043D\u0435\u0442."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Aqu\xED creamos tecnolog\xEDa para planetas futuros."
    Object: {fileID: 0}
