  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name:
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0416\u0438\u0442\u0435\u043b\u0438 \u0434\u043e\u0431\u0440\u043e\u0432\u043e\u043b\u044c\u043d\u043e \u043e\u0442\u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u0438\u043b\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440\u0430. \u0410 \u043f\u043e\u0442\u043e\u043c \u0441\u043f\u0440\u044f\u0442\u0430\u043b\u0438 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u043e\u0432\u0430\u043d\u0438\u044f. \u041d\u0430\u0439\u0434\u0438\u0442\u0435 \u0438\u0445 \u0438 \u0437\u0430\u0431\u0435\u0440\u0438\u0442\u0435."
    Object: {fileID: 0}
  - Language: English
    Text: "The locals made a completely voluntary donation to the Professor. Then they hid it. Find it and collect it."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041c\u0435\u0448\u043a\u0430\u043d\u0446\u0456 \u0434\u043e\u0431\u0440\u043e\u0432\u0456\u043b\u044c\u043d\u043e \u0432\u0456\u0434\u0434\u044f\u0447\u0438\u043b\u0438 \u043f\u0440\u043e\u0444\u0435\u0441\u043e\u0440\u0443. \u0410 \u043f\u043e\u0442\u0456\u043c \u0441\u0445\u043e\u0432\u0430\u043b\u0438 \u043f\u043e\u0436\u0435\u0440\u0442\u0432\u0438. \u0417\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u0457\u0445 \u0456 \u0437\u0430\u0431\u0435\u0440\u0456\u0442\u044c."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Los habitantes hicieron una donaci\u00f3n totalmente voluntaria al Profesor. Luego la escondieron. Encu\u00e9ntrala y rec\u00f3gela."
    Object: {fileID: 0}
