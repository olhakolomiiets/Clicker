--- !u!114 &900000000000000051
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000049}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041A\u0443\u043F\u0438 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0435. \u041D\u0430\u0434\u043E
      \u0436\u0435 \u043A\u0430\u043A-\u0442\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u0442\u044C
      \u043D\u0430\u0448\u0443 \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u043E\u0442
      \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043C\u0443\u0441\u043E\u0440\u0430."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041A\u0443\u043F\u0438 \u0449\u043E\u0441\u044C \u0433\u0430\u0440\u043D\u0435.
      \u0422\u0440\u0435\u0431\u0430 \u0436 \u044F\u043A\u043E\u0441\u044C \u0432\u0456\u0434\u0440\u0456\u0437\u043D\u044F\u0442\u0438
      \u043D\u0430\u0448\u0443 \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u0432\u0456\u0434
      \u043A\u043E\u0441\u043C\u0456\u0447\u043D\u043E\u0433\u043E \u0441\u043C\u0456\u0442\u0442\u044F."
    Object: {fileID: 0}
  - Language: English
    Text: Buy something nice. We need some way to tell our planet apart from space
      junk.
    Object: {fileID: 0}
  - Language: Spanish
    Text: Compra algo bonito. Hay que distinguir nuestro planeta de la basura espacial.
    Object: {fileID: 0}
