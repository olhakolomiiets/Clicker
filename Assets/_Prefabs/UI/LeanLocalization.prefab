--- !u!114 &1164473930529955012
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2911167166699478191}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043A\u0443\u043F\u0438\u043C \u0434\u0435\u0440\u0435\u0432\u043E
      \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435. \u0415\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0437\u0435\u043B\u0435\u043D\u0438, \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043F\u0440\u0438\u0431\u044B\u043B\u0438!\n\u041D\u0443 \u0438 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C
      \u0433\u043E\u0440\u0430\u0437\u0434\u043E \u043B\u0443\u0447\u0448\u0435."
    Object: {fileID: 0}
  - Language: English
    Text: 'Now let''s buy a bigger tree. More greenery, more profit!

      And the
      planet will look much better, too.'
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0435\u043F\u0435\u0440 \u043A\u0443\u043F\u0456\u043C\u043E \u0434\u0435\u0440\u0435\u0432\u043E
      \u043F\u043E\u0431\u0456\u043B\u044C\u0448\u0435. \u0429\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0437\u0435\u043B\u0435\u043D\u0456, \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u043F\u0440\u0438\u0431\u0443\u0442\u043A\u0443!\n\u0406 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0442\u0438\u043C\u0435 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u043A\u0440\u0430\u0449\u0435."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Ahora compremos un \xE1rbol m\xE1s grande. \xA1M\xE1s verde, m\xE1s ganancias!\nY
      el planeta se ver\xE1 mucho mejor."
    Object: {fileID: 0}
