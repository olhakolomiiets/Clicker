  m_GameObject: {fileID: 3290781177774364079}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u041D\u0430\u0448\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0437\u0435\u043B\u0435\u043D\u0435\u0442\u044C!"
    Object: {fileID: 0}
  - Language: English
    Text: Great! Our planet is starting to turn green!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0427\u0443\u0434\u043E\u0432\u043E! \u041D\u0430\u0448\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u043F\u043E\u0447\u0438\u043D\u0430\u0454 \u0437\u0435\u043B\u0435\u043D\u0456\u0442\u0438!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Genial! \xA1Nuestro planeta empieza a ponerse verde!"
    Object: {fileID: 0}
