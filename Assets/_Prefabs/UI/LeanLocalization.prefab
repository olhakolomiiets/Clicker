  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "You\u2019ve gathered enough coins to buy automation"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0422\u044B \u043D\u0430\u043A\u043E\u043F\u0438\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043C\u043E\u043D\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u043A\u0443\u043F\u0438\u0442\u044C
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u044E"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Has reunido suficientes monedas para comprar automatizaci\xF3n"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0438 \u043D\u0430\u043A\u043E\u043F\u0438\u0447\u0438\u0432 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u043C\u043E\u043D\u0435\u0442, \u0449\u043E\u0431 \u043A\u0443\u043F\u0438\u0442\u0438
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0456\u044E"
    Object: {fileID: 0}
