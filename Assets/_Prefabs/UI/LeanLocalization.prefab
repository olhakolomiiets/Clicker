--- !u!114 &4662166928416458687
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4262014146099069254}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0418 \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
      \u043D\u0430\u0443\u0447\u043D\u044B\u0435 \u043F\u0440\u043E\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u044F."
    Object: {fileID: 0}
  - Language: English
    Text: And sometimes, science gets a little messy.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0406\u043D\u043E\u0434\u0456 \u043D\u0430\u0443\u043A\u0430 \u0442\u0440\u043E\u0445\u0438
      \u0432\u0438\u0445\u043E\u0434\u0438\u0442\u044C \u0437-\u043F\u0456\u0434
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Y a veces la ciencia se desordena un poco.
    Object: {fileID: 0}
