--- !u!114 &900000000000000024
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000022}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041A\u043B\u0438\u0435\u043D\u0442 \u0434\u043E\u0432\u043E\u043B\u0435\u043D
      \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435\u043C \u0438 \u0433\u043E\u0442\u043E\u0432
      \u043A\u0438\u043D\u0443\u0442\u044C \u043F\u0430\u0440\u0443 \u0430\u043B\u043C\u0430\u0437\u043E\u0432
      \u0441\u0432\u0435\u0440\u0445\u0443 \u043F\u043E\u0441\u043B\u0435 \u0440\u0435\u043A\u043B\u0430\u043C\u044B."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041A\u043B\u0456\u0454\u043D\u0442 \u0437\u0430\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u0438\u0439
      \u043C\u0430\u0439\u0436\u0435 \u0432\u0441\u0456\u043C \u0456 \u0433\u043E\u0442\u043E\u0432\u0438\u0439
      \u0434\u043E\u043A\u0438\u043D\u0443\u0442\u0438 \u043A\u0456\u043B\u044C\u043A\u0430
      \u0430\u043B\u043C\u0430\u0437\u0456\u0432 \u043F\u0456\u0441\u043B\u044F \u0440\u0435\u043A\u043B\u0430\u043C\u0438."
    Object: {fileID: 0}
  - Language: English
    Text: The client is happy with almost everything and will throw in a couple of
      diamonds after an ad.
    Object: {fileID: 0}
  - Language: Spanish
    Text: "El cliente est\xE1 satisfecho con casi todo y nos dar\xE1 un par de diamantes
      extra despu\xE9s de un anuncio."
    Object: {fileID: 0}
--- !u!1 &900000000000000025
