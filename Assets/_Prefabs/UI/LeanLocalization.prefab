--- !u!114 &5371779972029510703
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8452360689556658760}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0418\u043C\u0435\u043D\u043D\u043E \u0437\u0434\u0435\u0441\u044C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441."
    Object: {fileID: 0}
  - Language: English
    Text: This is where real progress begins.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0421\u0430\u043C\u0435 \u0442\u0443\u0442 \u043F\u043E\u0447\u0438\u043D\u0430\u0454\u0442\u044C\u0441\u044F
      \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439 \u043F\u0440\u043E\u0433\u0440\u0435\u0441."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Aqu\xED empieza el progreso de verdad."
    Object: {fileID: 0}
