--- !u!114 &7460993232505564483
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6372378348458150727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u0440\u0430\u0432\u0434\u0430, \u043D\u0430 \u0435\u0433\u043E
      \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0443 \u043F\u043E\u043A\u0430 \u043D\u0435
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u041F\u043E\u0434\u043D\u0430\u0436\u043C\u0438!"
    Object: {fileID: 0}
  - Language: English
    Text: We can't afford his salary just yet, though. Keep tapping!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430, \u043D\u0430 \u0439\u043E\u0433\u043E
      \u0437\u0430\u0440\u043F\u043B\u0430\u0442\u0443 \u043F\u043E\u043A\u0438 \u043D\u0435
      \u0432\u0438\u0441\u0442\u0430\u0447\u0430\u0454. \u041D\u0430\u0442\u0438\u0441\u043A\u0430\u0439
      \u0430\u043A\u0442\u0438\u0432\u043D\u0456\u0448\u0435!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Aunque todav\xEDa no nos alcanza para su sueldo. \xA1Sigue pulsando!"
    Object: {fileID: 0}
