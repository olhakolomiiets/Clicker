--- !u!114 &3665280489468239267
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1642772659511550053}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E. \u041A\u0443\u0441\u0442 \u0443\u0436\u0435
      \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0435. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043A\u0430\u0436\u0434\u043E\u0435 \u043D\u0430\u0436\u0430\u0442\u0438\u0435
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435!"
    Object: {fileID: 0}
  - Language: English
    Text: Great! The bush is on the planet. Now every tap earns more!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0427\u0443\u0434\u043E\u0432\u043E. \u041A\u0443\u0449 \u0443\u0436\u0435
      \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0456. \u0422\u0435\u043F\u0435\u0440
      \u043A\u043E\u0436\u043D\u0435 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u043D\u043D\u044F
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u0431\u0456\u043B\u044C\u0448\u0435!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Genial! El arbusto ya est\xE1 en el planeta. \xA1Ahora cada toque
      nos da m\xE1s!"
    Object: {fileID: 0}
