  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: English
    Text: Unable to purchase the skin. Check your diamond balance.
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043A\u0443\u043F\u0438\u0442\u044C
      \u0441\u043A\u0438\u043D. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u0431\u0430\u043B\u0430\u043D\u0441 \u0430\u043B\u043C\u0430\u0437\u043E\u0432."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043A\u0443\u043F\u0438\u0442\u0438
      \u0441\u043A\u0456\u043D. \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435
      \u0431\u0430\u043B\u0430\u043D\u0441 \u0430\u043B\u043C\u0430\u0437\u0456\u0432."
    Object: {fileID: 0}
  - Language: Spanish
    Text: No se pudo comprar el aspecto. Comprueba tu saldo de diamantes.
    Object: {fileID: 0}
