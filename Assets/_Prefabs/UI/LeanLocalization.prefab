  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E \u0434\u043B\u044F \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F."
    Object: {fileID: 0}
  - Language: English
    Text: Now the upgrade can be developed.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0435\u043F\u0435\u0440 \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u044F
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0435 \u0434\u043B\u044F \u0440\u043E\u0437\u0432\u0438\u0442\u043A\u0443."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Ahora la mejora se puede desarrollar.
    Object: {fileID: 0}
