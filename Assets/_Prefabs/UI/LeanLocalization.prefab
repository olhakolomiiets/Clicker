--- !u!114 &3620971070468523754
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4087534657263849413}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "Add more plants \u2014 let your world grow and flourish faster.\nThe more
      life, the more coins for new discoveries!"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0414\u043E\u0431\u0430\u0432\u044C \u0435\u0449\u0435 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439
      \u2014 \u043F\u0443\u0441\u0442\u044C \u0442\u0432\u043E\u0439 \u043C\u0438\u0440
      \u0440\u0430\u0441\u0442\u0435\u0442 \u0438 \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435.\n\u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
      \u0436\u0438\u0437\u043D\u0438, \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
      \u043C\u043E\u043D\u0435\u0442 \u0434\u043B\u044F \u043D\u043E\u0432\u044B\u0445
      \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0439!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "A\xF1ade m\xE1s plantas \u2014 deja que tu mundo crezca y prospere m\xE1s
      r\xE1pido.\n\xA1Cuanta m\xE1s vida, m\xE1s monedas para nuevos descubrimientos!"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0414\u043E\u0434\u0430\u0439 \u0449\u0435 \u0431\u0456\u043B\u044C\u0448\u0435
      \u0440\u043E\u0441\u043B\u0438\u043D \u2014 \u043D\u0435\u0445\u0430\u0439
      \u0442\u0432\u0456\u0439 \u0441\u0432\u0456\u0442 \u0440\u043E\u0441\u0442\u0435
      \u0456 \u043F\u0440\u043E\u0446\u0432\u0456\u0442\u0430\u0454 \u0448\u0432\u0438\u0434\u0448\u0435.\n\u0427\u0438\u043C
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0436\u0438\u0442\u0442\u044F, \u0442\u0438\u043C
      \u0431\u0456\u043B\u044C\u0448\u0435 \u043C\u043E\u043D\u0435\u0442 \u0434\u043B\u044F
      \u043D\u043E\u0432\u0438\u0445 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u0456\u0432!"
    Object: {fileID: 0}
