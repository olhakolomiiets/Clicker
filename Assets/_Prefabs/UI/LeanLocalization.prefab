--- !u!114 &5371779972029510703
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8452360689556658760}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u043E\u0444\u0438\u0441
      \u0442\u0430\u043A\u043E\u0433\u043E \u043D\u0435 \u0443\u043C\u0435\u0435\u0442."
    Object: {fileID: 0}
  - Language: English
    Text: A fancy office can't do that.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0413\u0430\u0440\u043D\u0438\u0439 \u043E\u0444\u0456\u0441 \u0442\u0430\u043A\u043E\u0433\u043E
      \u043D\u0435 \u0432\u043C\u0456\u0454."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Una oficina bonita no puede hacer eso.
    Object: {fileID: 0}
