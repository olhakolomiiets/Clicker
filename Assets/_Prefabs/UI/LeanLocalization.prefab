--- !u!114 &2710017746142204016
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2369468277471912481}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0417\u0430\u043A\u0430\u0436\u0435\u043C \u043F\u0435\u0440\u0432\u044B\u0439
      \u0434\u043E\u043C. \u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0438."
    Object: {fileID: 0}
  - Language: English
    Text: Let's order our first house. We'll start with the packaging.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0417\u0430\u043C\u043E\u0432\u0438\u043C\u043E \u043F\u0435\u0440\u0448\u0438\u0439
      \u0431\u0443\u0434\u0438\u043D\u043E\u043A. \u041F\u043E\u0447\u043D\u0435\u043C\u043E
      \u0437 \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Encarguemos nuestra primera casa. Empecemos por el embalaje.
    Object: {fileID: 0}
