--- !u!114 &2099588821720605477
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1923476752832022167}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439."
    Object: {fileID: 0}
  - Language: English
    Text: Each upgrade is its own research path.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041A\u043E\u0436\u043D\u0435 \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u044F
      \u043C\u0430\u0454 \u043E\u043A\u0440\u0435\u043C\u0438\u0439 \u043D\u0430\u043F\u0440\u044F\u043C
      \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u044C."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Cada mejora es una l\xEDnea de investigaci\xF3n."
    Object: {fileID: 0}
