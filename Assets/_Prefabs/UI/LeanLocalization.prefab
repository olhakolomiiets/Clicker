--- !u!114 &4653143528662145354
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1322150290560145851}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Thank you for playing our game!



      We appreciate your opinion and
      would be glad if you leave a review about our app.



      Did you like our
      game?'
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0438\u0433\u0440\u0430\u0435\u0442\u0435
      \u0432 \u043D\u0430\u0448\u0443 \u0438\u0433\u0440\u0443!\r\n\r\n\u041C\u044B
      \u0446\u0435\u043D\u0438\u043C \u0432\u0430\u0448\u0435 \u043C\u043D\u0435\u043D\u0438\u0435
      \u0438 \u0431\u0443\u0434\u0435\u043C \u0440\u0430\u0434\u044B, \u0435\u0441\u043B\u0438
      \u0432\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0435 \u043E\u0442\u0437\u044B\u0432
      \u043E \u043D\u0430\u0448\u0435\u043C \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0438.\r\n\r\n\u0412\u0430\u043C
      \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u043D\u0430\u0448\u0430
      \u0438\u0433\u0440\u0430?"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Gracias por jugar nuestro juego!\r\n\r\nValoramos tu opini\xF3n y
      estar\xEDamos encantados si dejas un comentario sobre nuestra aplicaci\xF3n.\r\n\r\n\xBFTe
      gust\xF3 nuestro juego"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0414\u044F\u043A\u0443\u0454\u043C\u043E \u0437\u0430 \u0442\u0435,
      \u0449\u043E \u0433\u0440\u0430\u0454\u0442\u0435 \u0443 \u043D\u0430\u0448\u0443
      \u0433\u0440\u0443!\r\n\r\n\u041C\u0438 \u0446i\u043D\u0443\u0454\u043C\u043E
      \u0432\u0430\u0448\u0443 \u0434\u0443\u043C\u043A\u0443 i \u0431\u0443\u0434\u0435\u043C\u043E
      \u0440\u0430\u0434i, \u044F\u043A\u0449\u043E \u0432\u0438 \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0435
      \u0432i\u0434\u0433\u0443\u043A \u043F\u0440\u043E \u043D\u0430\u0448 \u0434\u043E\u0434\u0430\u0442\u043E\u043A.\r\n\r\n\u0427\u0438
      \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u043B\u0430\u0441\u044C \u0432\u0430\u043C
      \u043D\u0430\u0448\u0430 \u0433\u0440\u0430?"
    Object: {fileID: 0}
