  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: Please write your sentences, edits, or recommendations
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041D\u0430\u043F\u0438\u0448\u0438\u0442\u0435 \u0432\u0430\u0448\u0438
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F, \u043F\u0440\u0430\u0432\u043A\u0438
      \u0438\u043B\u0438 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u0438"
    Object: {fileID: 0}
  - Language: Spanish
    Text: Por favor, escribe tus frases, ediciones o recomendaciones
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043D\u0430\u043F\u0438\u0448i\u0442\u044C
      \u0432\u0430\u0448i \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446ii, \u043F\u0440\u0430\u0432\u043A\u0438
      \u0430\u0431\u043E \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446ii"
    Object: {fileID: 0}
