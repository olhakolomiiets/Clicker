--- !u!114 &2796574765520163269
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6076752904070250987}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0411\u0435\u0440\u0438 \u044D\u0442\u043E\u0442. \u041D\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442."
    Object: {fileID: 0}
  - Language: English
    Text: Go with this one. We can't afford the others.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0411\u0435\u0440\u0438 \u0446\u0435\u0439. \u041D\u0430 \u0440\u0435\u0448\u0442\u0443
      \u043D\u0435 \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Elige este. No nos alcanza para los dem\xE1s."
    Object: {fileID: 0}
