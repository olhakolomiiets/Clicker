--- !u!114 &900000000000000003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0421\u0440\u043E\u0447\u043D\u044B\u0439 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0442\u0435\u043D\u0434\u0435\u0440: \u0440\u0435\u043A\u043B\u0430\u043C\u0430
      \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u043F\u0440\u0438\u0431\u044B\u043B\u044C
      x2"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0435\u0440\u043C\u0456\u043D\u043E\u0432\u0438\u0439 \u043A\u043E\u0441\u043C\u0456\u0447\u043D\u0438\u0439
      \u0442\u0435\u043D\u0434\u0435\u0440: \u0440\u0435\u043A\u043B\u0430\u043C\u0430
      \u0437\u0430\u0440\u0430\u0437 \u2014 \u043F\u0440\u0438\u0431\u0443\u0442\u043E\u043A
      \u04452!"
    Object: {fileID: 0}
  - Language: English
    Text: 'Urgent space contract: watch an ad now and double your profits!'
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Contrato espacial urgente! Mira un anuncio y duplica tus ganancias."
    Object: {fileID: 0}
