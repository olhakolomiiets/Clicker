  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041D\u043E \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0431\u0443\u0434\u0435\u0442
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0433\u043E\u0440\u0430\u0437\u0434\u043E
      \u043B\u0443\u0447\u0448\u0435."
    Object: {fileID: 0}
  - Language: English
    Text: But the station will look much better.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0410\u043B\u0435 \u0441\u0442\u0430\u043D\u0446\u0456\u044F \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0442\u0438\u043C\u0435
