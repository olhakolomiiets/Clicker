  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0412\u0441\u0451, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043A\u0443\u043F\u043A\u0438 \u043F\u043B\u0430\u043D\u0435\u0442\u044B."
    Object: {fileID: 0}
  - Language: English
    Text: All that's left after buying the planet.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0423\u0441\u0435, \u0449\u043E \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
      \u043F\u0456\u0441\u043B\u044F \u043A\u0443\u043F\u0456\u0432\u043B\u0456 \u043F\u043B\u0430\u043D\u0435\u0442\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Todo lo que queda despu\xE9s de comprar el planeta."
    Object: {fileID: 0}
