  data: 0
  entries:
  - Language: Russian
    Text: "\u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u043C \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438."
