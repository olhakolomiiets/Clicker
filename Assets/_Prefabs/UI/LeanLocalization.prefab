  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2408098173398758371}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u0447\u0442\u043E
      \u0437\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C."
    Object: {fileID: 0}
  - Language: English
    Text: Let's see what we can build here.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F, \u0449\u043E
      \u0442\u0443\u0442 \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Veamos qu\xE9 podemos construir aqu\xED."
    Object: {fileID: 0}
