--- !u!114 &3740510714382516363
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6115629733161110041}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0410 \u0432\u043E\u0442 \u044D\u0442\u043E \u0443\u0436\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u043E\u043B\u0435\u0437\u043D\u043E."
    Object: {fileID: 0}
  - Language: English
    Text: Now this is truly useful.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0410 \u043E\u0441\u044C \u0446\u0435 \u0432\u0436\u0435 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
      \u043A\u043E\u0440\u0438\u0441\u043D\u043E."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Esto s\xED que es \xFAtil."
    Object: {fileID: 0}
