--- !u!114 &8801000000000000014
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8801000000000000012}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name:
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0421\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044c \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043f\u043b\u0430\u0442\u0443 \u0437\u0430 \u0443\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u0435 \u0436\u0438\u0442\u0435\u043b\u0435\u0439 \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0435. \u041c\u0435\u0441\u0442\u043d\u044b\u0435 \u0441\u043f\u0440\u044f\u0442\u0430\u043b\u0438 \u043d\u0430\u043b\u043e\u0433\u0438. \u041d\u0430\u0439\u0434\u0438\u0442\u0435 \u0438\u0445, \u043f\u043e\u043a\u0430 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0443\u043b\u0435\u0442\u0435\u043b."
    Object: {fileID: 0}
  - Language: English
    Text: "The Creator charges the locals for keeping them on the planet. They've hidden the taxes. Find them before anyone floats away."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0432\u043e\u0440\u0435\u0446\u044c \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u043f\u043b\u0430\u0442\u0443 \u0437\u0430 \u0443\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u043c\u0435\u0448\u043a\u0430\u043d\u0446\u0456\u0432 \u043d\u0430 \u043f\u043b\u0430\u043d\u0435\u0442\u0456. \u041c\u0456\u0441\u0446\u0435\u0432\u0456 \u0441\u0445\u043e\u0432\u0430\u043b\u0438 \u043f\u043e\u0434\u0430\u0442\u043a\u0438. \u0417\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u0457\u0445, \u043f\u043e\u043a\u0438 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u043e\u043b\u0435\u0442\u0456\u0432."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "El Creador cobra por mantener a los habitantes en el planeta. Han escondido los impuestos. Encu\u00e9ntralos antes de que alguien salga flotando."
    Object: {fileID: 0}
--- !u!1 &8801000000000000015
