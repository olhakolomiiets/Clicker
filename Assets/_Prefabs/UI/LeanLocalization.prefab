  m_GameObject: {fileID: 7724526357042016771}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0412\u044B \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0437\u0430\u043A\u0430\u0437\u044B \u043D\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
      \u043F\u043B\u0430\u043D\u0435\u0442?"
    Object: {fileID: 0}
  - Language: English
    Text: Do you accept orders to create planets?
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0412\u0438 \u043F\u0440\u0438\u0439\u043C\u0430\u0454\u0442\u0435 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F
      \u043D\u0430 \u0441\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F \u043F\u043B\u0430\u043D\u0435\u0442?"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xBFAceptan encargos para crear planetas?"
    Object: {fileID: 0}
