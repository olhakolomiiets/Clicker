  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u0440\u043E\u0431\u043A\u0430."
    Object: {fileID: 0}
  - Language: English
    Text: Now we have a box of our very own.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0435\u043F\u0435\u0440 \u0443 \u043D\u0430\u0441 \u0454 \u0432\u043B\u0430\u0441\u043D\u0430
      \u043A\u043E\u0440\u043E\u0431\u043A\u0430."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Ahora tenemos nuestra propia caja.
    Object: {fileID: 0}
