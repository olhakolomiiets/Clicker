--- !u!114 &5456972222808668965
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8900135983069604858}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u043E\u0440\u0430 \u0434\u0435\u043B\u0430\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438!
      \u0422\u043E\u0447\u043D\u0435\u0435, \u0442\u0443\u0442 \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E
      \u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043D\u043A\u0438. \u041D\u0430\u0436\u0438\u043C\u0430\u0439
      \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0445 \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C!"
    Object: {fileID: 0}
  - Language: English
    Text: Time to make money! Except... they're gears for some reason. Tap the button
      to earn them!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0427\u0430\u0441 \u0437\u0430\u0440\u043E\u0431\u043B\u044F\u0442\u0438
      \u0433\u0440\u043E\u0448\u0456! \u0422\u043E\u0447\u043D\u0456\u0448\u0435,
      \u0442\u0443\u0442 \u0447\u043E\u043C\u0443\u0441\u044C \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u0456.
      \u041D\u0430\u0442\u0438\u0441\u043A\u0430\u0439 \u043A\u043D\u043E\u043F\u043A\u0443,
      \u0449\u043E\u0431 \u0457\u0445 \u0437\u0430\u0440\u043E\u0431\u043B\u044F\u0442\u0438!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Hora de ganar dinero! Aunque aqu\xED, por alguna raz\xF3n, son engranajes.
      \xA1Pulsa el bot\xF3n para conseguirlos!"
    Object: {fileID: 0}
