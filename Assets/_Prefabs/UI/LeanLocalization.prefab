  data: 0
  entries:
  - Language: Russian
    Text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0431\u044A\u0435\u043A\u0442
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u0438."
