  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u044B
      \u043D\u0430\u0447\u043D\u0443\u0442\u0441\u044F \u043D\u0435 \u0441\u0440\u0430\u0437\u0443."
    Object: {fileID: 0}
  - Language: English
    Text: I just hope the disasters don't start right away.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0438
      \u043F\u043E\u0447\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0435 \u043E\u0434\u0440\u0430\u0437\u0443."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Espero que las cat\xE1strofes no empiecen de inmediato."
    Object: {fileID: 0}
