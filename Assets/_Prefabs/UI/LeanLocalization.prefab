  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u043E\u0440\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C,
      \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435."
    Object: {fileID: 0}
  - Language: English
    Text: Time to see what you can do in practice.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0427\u0430\u0441 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438, \u0449\u043E
      \u0432 \u0442\u0435\u0431\u0435 \u0432\u0438\u0439\u0434\u0435 \u043D\u0430
      \u043F\u0440\u0430\u043A\u0442\u0438\u0446\u0456."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Hora de ver qu\xE9 puedes hacer en la pr\xE1ctica."
    Object: {fileID: 0}
