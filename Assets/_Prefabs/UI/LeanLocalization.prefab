  data: 0
  entries:
  - Language: Russian
    Text: "\u042D\u0442\u043E \u043D\u0435 \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430
      \u0431\u043E\u043D\u0443\u0441\u044B."
