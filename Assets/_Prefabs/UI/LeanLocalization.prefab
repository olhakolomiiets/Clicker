--- !u!114 &8877782263955494315
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6475374461774353081}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "Here, you\u2019ll find unique elements that make your world more stunning.\nThey
      don\u2019t generate income, but what is a Maker without aesthetics?"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0417\u0434\u0435\u0441\u044C \u0435\u0441\u0442\u044C \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0434\u0435\u043B\u0430\u044E\u0442 \u043C\u0438\u0440 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0435\u0435.\n\u041E\u043D\u0438
      \u043D\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u0434\u043E\u0445\u043E\u0434\u0430,
      \u043D\u043E \u0447\u0442\u043E \u0437\u0430 \u0422\u0432\u043E\u0440\u0435\u0446
      \u0431\u0435\u0437 \u044D\u0441\u0442\u0435\u0442\u0438\u043A\u0438?"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Aqu\xED encontrar\xE1s elementos \xFAnicos que har\xE1n tu mundo m\xE1s
      hermoso.\nNo generan ingresos, pero \xBFqu\xE9 es un Hacedor sin est\xE9tica?"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0443\u0442 \u0454 \u0443\u043D\u0456\u043A\u0430\u043B\u044C\u043D\u0456
      \u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0438, \u0449\u043E \u0440\u043E\u0431\u043B\u044F\u0442\u044C
      \u0442\u0432\u0456\u0439 \u0441\u0432\u0456\u0442 \u043A\u0440\u0430\u0441\u0438\u0432\u0456\u0448\u0438\u043C.\n\u0412\u043E\u043D\u0438
      \u043D\u0435 \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442\u044C \u0434\u043E\u0445\u043E\u0434\u0443,
      \u0430\u043B\u0435 \u0449\u043E \u0437\u0430 \u0422\u0432\u043E\u0440\u0435\u0446\u044C
      \u0431\u0435\u0437 \u0435\u0441\u0442\u0435\u0442\u0438\u043A\u0438?"
    Object: {fileID: 0}
