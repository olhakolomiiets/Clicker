--- !u!114 &900000000000000069
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 900000000000000067}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041C\u044B \u0441\u0442\u0440\u043E\u0438\u043C \u043F\u043B\u0430\u043D\u0435\u0442\u0443
      \u0438\u043B\u0438 \u0436\u0434\u0451\u043C, \u043F\u043E\u043A\u0430 \u043E\u043D\u0430
      \u0441\u0430\u043C\u0430 \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u0438\u0440\u0443\u0435\u0442?
      \u0414\u0430\u0432\u0430\u0439 \u043A\u0443\u043F\u0438\u043C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u0432\u0430\u043B\u044E\u0442\u044B."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041C\u0438 \u0431\u0443\u0434\u0443\u0454\u043C\u043E \u043F\u043B\u0430\u043D\u0435\u0442\u0443
      \u0447\u0438 \u0447\u0435\u043A\u0430\u0454\u043C\u043E, \u043F\u043E\u043A\u0438
      \u0432\u043E\u043D\u0430 \u0441\u0430\u043C\u0430 \u0435\u0432\u043E\u043B\u044E\u0446\u0456\u043E\u043D\u0443\u0454?
      \u0414\u0430\u0432\u0430\u0439 \u043A\u0443\u043F\u0438\u043C\u043E \u0442\u0440\u043E\u0445\u0438
      \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0457 \u0432\u0430\u043B\u044E\u0442\u0438."
    Object: {fileID: 0}
  - Language: English
    Text: Are we building a planet, or waiting for it to evolve on its own? Let's
      buy some local currency.
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xBFEstamos construyendo un planeta o esperando a que evolucione solo?
      Vamos a comprar algo de moneda local."
    Object: {fileID: 0}
