--- !u!114 &9159848974084777651
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5583405565909200434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043D\u043A\u0438!
      \u041A\u0430\u0436\u0434\u043E\u0435 \u043D\u0430\u0436\u0430\u0442\u0438\u0435
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u0435\u0449\u0451. \u042D\u0442\u043E
      \u0447\u0443\u0434\u043E!"
    Object: {fileID: 0}
  - Language: English
    Text: Our first gears! Every tap earns more. It's a miracle!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041F\u0435\u0440\u0448\u0456 \u0448\u0435\u0441\u0442\u0435\u0440\u043D\u0456!
      \u041A\u043E\u0436\u043D\u0435 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u043D\u043D\u044F
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u0449\u0435. \u0426\u0435
      \u0434\u0438\u0432\u043E!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Nuestros primeros engranajes! Cada toque nos da m\xE1s. \xA1Es un
      milagro!"
    Object: {fileID: 0}
