--- !u!114 &8801000000000000032
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8801000000000000030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name:
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0416\u0438\u0442\u0435\u043b\u0438 \u0441\u043e\u0431\u0440\u0430\u043b\u0438 \u0434\u0435\u043d\u044c\u0433\u0438, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u043e\u0440 \u043f\u043e\u0434\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u043b\u0441\u044f. \u041d\u0430\u0439\u0434\u0438\u0442\u0435 \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0438\u044e \u0438 \u043f\u043e\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u043d\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044c\u0441\u044f."
    Object: {fileID: 0}
  - Language: English
    Text: "The locals pooled their money to keep the Professor away a little longer. Find the payoff and try not to overstay your welcome."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041c\u0435\u0448\u043a\u0430\u043d\u0446\u0456 \u0437\u0456\u0431\u0440\u0430\u043b\u0438 \u0433\u0440\u043e\u0448\u0456, \u0449\u043e\u0431 \u043f\u0440\u043e\u0444\u0435\u0441\u043e\u0440 \u044f\u043a\u043e\u043c\u043e\u0433\u0430 \u0434\u043e\u0432\u0448\u0435 \u043d\u0435 \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0432\u0441\u044f. \u0417\u043d\u0430\u0439\u0434\u0456\u0442\u044c \u043a\u043e\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u0456\u044e \u0439 \u043f\u043e\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044f \u043d\u0435 \u0437\u0430\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u0442\u0438\u0441\u044f."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Los habitantes reunieron dinero para que el Profesor tardara m\u00e1s en volver. Encuentra el pago y procura no quedarte mucho tiempo."
    Object: {fileID: 0}
