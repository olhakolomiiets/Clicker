  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "You\u2019ve gathered enough coins to add a new object"
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0422\u044B \u043D\u0430\u043A\u043E\u043F\u0438\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043C\u043E\u043D\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u043D\u043E\u0432\u044B\u0439 \u043E\u0431\u044A\u0435\u043A\u0442"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Has reunido suficientes monedas para a\xF1adir un nuevo objeto"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0438 \u043D\u0430\u043A\u043E\u043F\u0438\u0447\u0438\u0432 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u043C\u043E\u043D\u0435\u0442, \u0449\u043E\u0431 \u0434\u043E\u0434\u0430\u0442\u0438
      \u043D\u043E\u0432\u0438\u0439 \u043E\u0431'\u0454\u043A\u0442"
    Object: {fileID: 0}
