--- !u!114 &6771860392579373235
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6195453891984325821}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435
      \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u043A\u0430\u0447\u0430\u0442\u044C
      \u0434\u043E \u0442\u0440\u0451\u0445 \u0443\u0440\u043E\u0432\u043D\u0435\u0439.\n\u041A\u0430\u0436\u0434\u044B\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442
      \u0431\u043E\u043D\u0443\u0441.\n\n\u042D\u0442\u0430 \u043A\u043D\u043E\u043F\u043A\u0430
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0446\u0438\u0444\u0440\u044B \u0431\u043E\u043B\u044C\u0448\u0435."
    Object: {fileID: 0}
  - Language: English
    Text: 'Each upgrade has up to three levels.

      Each level makes the bonus
      stronger.


      This button makes the numbers bigger.'
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041A\u043E\u0436\u043D\u0435 \u043F\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u043D\u044F
      \u043C\u043E\u0436\u043D\u0430 \u043F\u0456\u0434\u043D\u044F\u0442\u0438 \u0434\u043E
      \u0442\u0440\u044C\u043E\u0445 \u0440\u0456\u0432\u043D\u0456\u0432.\n\u041A\u043E\u0436\u0435\u043D
      \u0440\u0456\u0432\u0435\u043D\u044C \u043F\u043E\u0441\u0438\u043B\u044E\u0454
      \u0431\u043E\u043D\u0443\u0441.\n\n\u0426\u044F \u043A\u043D\u043E\u043F\u043A\u0430
      \u0440\u043E\u0431\u0438\u0442\u044C \u0447\u0438\u0441\u043B\u0430 \u0431\u0456\u043B\u044C\u0448\u0438\u043C\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Cada mejora tiene hasta tres niveles.\nCada nivel aumenta la bonificaci\xF3n.\n\nEste
      bot\xF3n hace crecer los n\xFAmeros."
    Object: {fileID: 0}
