  data: 0
  entries:
  - Language: Russian
    Text: "\u0427\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0439\u0442\u0438
      \u043D\u0435 \u0442\u0430\u043A?"
