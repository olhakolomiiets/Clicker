--- !u!114 &4834412389214207660
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8437302879992734360}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0437\u0430\u043A\u0430\u0437."
    Object: {fileID: 0}
  - Language: English
    Text: Excellent order.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u0435 \u0437\u0430\u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F."
    Object: {fileID: 0}
  - Language: Spanish
    Text: Un encargo excelente.
    Object: {fileID: 0}
