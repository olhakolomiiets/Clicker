--- !u!114 &1102172530248533634
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9048473871830783429}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041D\u043E \u0434\u0435\u043D\u0435\u0433 \u043D\u0430\u043C \u0445\u0432\u0430\u0442\u0438\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0441\u0430\u043C\u044B\u0439
      \u0434\u0435\u0448\u0435\u0432\u044B\u0439 \u0434\u043E\u043C."
    Object: {fileID: 0}
  - Language: English
    Text: But we can only afford the cheapest house.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0410\u043B\u0435 \u0433\u0440\u043E\u0448\u0435\u0439 \u043D\u0430\u043C
      \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u0442\u044C \u043B\u0438\u0448\u0435
      \u043D\u0430 \u043D\u0430\u0439\u0434\u0435\u0448\u0435\u0432\u0448\u0438\u0439
      \u0431\u0443\u0434\u0438\u043D\u043E\u043A."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Pero solo nos alcanza para la casa m\xE1s barata."
    Object: {fileID: 0}
