MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1923476752832022167}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u042D\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E \u043E\u0442\u0434\u044B\u0445\u0430\u044E\u0442.
      \u041F\u043E\u0440\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
      \u043D\u043E\u0440\u043C\u0443 \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0438
      \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430!"
    Object: {fileID: 0}
  - Language: English
    Text: These trees are taking too many breaks. Time to raise their oxygen production
      quota!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0426\u0456 \u0434\u0435\u0440\u0435\u0432\u0430 \u0437\u0430\u0431\u0430\u0433\u0430\u0442\u043E
      \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0432\u0430\u044E\u0442\u044C. \u0427\u0430\u0441
      \u043F\u0456\u0434\u0432\u0438\u0449\u0438\u0442\u0438 \u043D\u043E\u0440\u043C\u0443
      \u0432\u0438\u0440\u043E\u0431\u043D\u0438\u0446\u0442\u0432\u0430 \u043A\u0438\u0441\u043D\u044E!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Estos \xE1rboles se toman demasiados descansos. \xA1Hora de subirles la
      cuota de producci\xF3n de ox\xEDgeno!"
    Object: {fileID: 0}
