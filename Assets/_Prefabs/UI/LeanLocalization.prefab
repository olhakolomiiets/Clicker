--- !u!114 &6771860392579373235
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6195453891984325821}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0412 \u044D\u0442\u043E\u043C \u043E\u043A\u043D\u0435 \u043C\u043E\u0436\u043D\u043E
      \u0443\u043B\u0443\u0447\u0448\u0430\u0442\u044C \u043E\u0431\u044A\u0435\u043A\u0442\u044B.
      \u0412\u0441\u0435\u0433\u043E \u0435\u0441\u0442\u044C \u0442\u0440\u0438
      \u0443\u0440\u043E\u0432\u043D\u044F. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0441\u0442\u043E\u0438\u0442 \u0430\u043B\u043C\u0430\u0437\u044B \u0438
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0431\u043E\u043D\u0443\u0441\u043E\u0432!"
    Object: {fileID: 0}
  - Language: English
    Text: This is where you can upgrade your objects. There are three levels in total.
      Each new level costs diamonds and gives you bigger bonuses!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0423 \u0446\u044C\u043E\u043C\u0443 \u0432\u0456\u043A\u043D\u0456 \u043C\u043E\u0436\u043D\u0430
      \u043F\u043E\u043A\u0440\u0430\u0449\u0443\u0432\u0430\u0442\u0438 \u043E\u0431\u2019\u0454\u043A\u0442\u0438.
      \u0423\u0441\u044C\u043E\u0433\u043E \u0454 \u0442\u0440\u0438 \u0440\u0456\u0432\u043D\u0456.
      \u041A\u043E\u0436\u0435\u043D \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0439
      \u0440\u0456\u0432\u0435\u043D\u044C \u043A\u043E\u0448\u0442\u0443\u0454 \u0434\u0456\u0430\u043C\u0430\u043D\u0442\u0438
      \u0439 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u0449\u0435
      \u0431\u0456\u043B\u044C\u0448\u0435 \u0431\u043E\u043D\u0443\u0441\u0456\u0432!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Aqu\xED puedes mejorar tus objetos. Hay tres niveles en total. \xA1Cada
      nuevo nivel cuesta diamantes y te da mejores bonificaciones!"
    Object: {fileID: 0}
