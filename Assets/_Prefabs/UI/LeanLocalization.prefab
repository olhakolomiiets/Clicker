  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Want more planets?

      Mention it in your 5-star review!'
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0425\u043E\u0447\u0435\u0448\u044C \u0431\u043E\u043B\u044C\u0448\u0435
      \u043F\u043B\u0430\u043D\u0435\u0442? \u0423\u043F\u043E\u043C\u044F\u043D\u0438
      \u043E\u0431 \u044D\u0442\u043E\u043C \u0432 \u0441\u0432\u043E\u0451\u043C
      5-\u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043D\u043E\u043C \u043E\u0442\u0437\u044B\u0432\u0435!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xBFQuieres m\xE1s planetas?\n\xA1Menci\xF3nalo en tu rese\xF1a de 5 estrellas!"
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0425\u043E\u0447\u0435\u0448 \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u043B\u0430\u043D\u0435\u0442?
      \u0417\u0433\u0430\u0434\u0430\u0439 \u043F\u0440\u043E \u0446\u0435 \u0443
      \u0441\u0432\u043E\u0454\u043C\u0443 5-\u0437\u0456\u0440\u043A\u043E\u0432\u043E\u043C\u0443
      \u0432\u0456\u0434\u0433\u0443\u043A\u0443!"
    Object: {fileID: 0}
