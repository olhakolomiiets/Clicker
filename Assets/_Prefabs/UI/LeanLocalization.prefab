--- !u!114 &8900000000000000044
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8900000000000000042}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041D\u0430 \u044D\u0442\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u0435
      \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u0430 \u043D\u0430\u0433\u0440\u0430\u0434\u0430.
      \u041D\u0430\u0439\u0434\u0451\u0448\u044C \u0441\u0443\u043D\u0434\u0443\u043A
      \u2014 \u043E\u043D\u0430 \u0442\u0432\u043E\u044F!"
    Object: {fileID: 0}
  - Language: English
    Text: There's a reward hidden on this planet. Find the chest and it's yours!
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041D\u0430 \u0446\u0456\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u0456
      \u0437\u0430\u0445\u043E\u0432\u0430\u043D\u0430 \u043D\u0430\u0433\u043E\u0440\u043E\u0434\u0430.
      \u0417\u043D\u0430\u0439\u0434\u0435\u0448 \u0441\u043A\u0440\u0438\u043D\u044E
      \u2014 \u0432\u043E\u043D\u0430 \u0442\u0432\u043E\u044F!"
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Hay una recompensa escondida en este planeta. \xA1Encuentra el cofre y
      ser\xE1 tuya!"
    Object: {fileID: 0}
