--- !u!114 &5754271200034144303
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8974802354936179325}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "It\u2019s time to automate the processes. Now, your creations can generate
      income without your involvement."
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u041D\u0430\u0441\u0442\u0430\u043B\u043E \u0432\u0440\u0435\u043C\u044F
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u0432\u043E\u0438 \u0442\u0432\u043E\u0440\u0435\u043D\u0438\u044F \u0441\u043C\u043E\u0433\u0443\u0442
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C \u0434\u043E\u0445\u043E\u0434
      \u0431\u0435\u0437 \u0442\u0432\u043E\u0435\u0433\u043E \u0443\u0447\u0430\u0441\u0442\u0438\u044F."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Es hora de automatizar los procesos. Ahora, tus creaciones generar\xE1n
      ingresos sin tu intervenci\xF3n."
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u041D\u0430\u0441\u0442\u0430\u0432 \u0447\u0430\u0441 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0443\u0432\u0430\u0442\u0438
      \u043F\u0440\u043E\u0446\u0435\u0441\u0438. \u0422\u0435\u043F\u0435\u0440
      \u0442\u0432\u043E\u0457 \u0442\u0432\u043E\u0440\u0456\u043D\u043D\u044F \u0437\u043C\u043E\u0436\u0443\u0442\u044C
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0438 \u0434\u043E\u0445\u0456\u0434
      \u0431\u0435\u0437 \u0442\u0432\u043E\u0433\u043E \u0432\u0442\u0440\u0443\u0447\u0430\u043D\u043D\u044F."
    Object: {fileID: 0}
