--- !u!114 &4224764045198650874
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2045384422499494794}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0421 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C!
      \u041F\u0435\u0440\u0432\u0430\u044F \u043F\u043B\u0430\u043D\u0435\u0442\u0430
      \u0435\u0449\u0451 \u0446\u0435\u043B\u0430? \u0417\u043D\u0430\u0447\u0438\u0442,
      \u0437\u0430\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C \u0442\u044B
      \u0443\u0436\u0435 \u0443\u043C\u0435\u0435\u0448\u044C."
    Object: {fileID: 0}
  - Language: English
    Text: Welcome back! Is your first planet still in one piece? Then you already
      know how to make money.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0417 \u043F\u043E\u0432\u0435\u0440\u043D\u0435\u043D\u043D\u044F\u043C!
      \u041F\u0435\u0440\u0448\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0430 \u0449\u0435
      \u0446\u0456\u043B\u0430? \u041E\u0442\u0436\u0435, \u0437\u0430\u0440\u043E\u0431\u043B\u044F\u0442\u0438
      \u0442\u0438 \u0432\u0436\u0435 \u0432\u043C\u0456\u0454\u0448."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "\xA1Qu\xE9 bueno que hayas vuelto! \xBFTu primer planeta sigue de una
      pieza? Entonces ya sabes c\xF3mo ganar dinero."
    Object: {fileID: 0}
