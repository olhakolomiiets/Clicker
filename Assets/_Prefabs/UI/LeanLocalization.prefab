  data: 0
  entries:
  - Language: Russian
    Text: "\u041E\u043D\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
      \u043C\u0435\u043D\u044F\u0442\u044C \u0432\u043D\u0435\u0448\u043D\u0438\u0439
      \u0432\u0438\u0434 \u0441\u0442\u0430\u043D\u0446\u0438\u0438."
    Object: {fileID: 0}
  - Language: English
    Text: They change how the station looks.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0412\u043E\u043D\u0438 \u0437\u043C\u0456\u043D\u044E\u044E\u0442\u044C
      \u0432\u0438\u0433\u043B\u044F\u0434 \u0441\u0442\u0430\u043D\u0446\u0456\u0457."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Cambian el aspecto de la estaci\xF3n."
