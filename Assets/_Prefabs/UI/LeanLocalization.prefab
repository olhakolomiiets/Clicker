  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u0417\u0434\u0435\u0441\u044C \u0431\u0443\u0434\u0435\u043C \u0436\u0438\u0442\u044C
      \u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u043E\u0432."
    Object: {fileID: 0}
  - Language: English
    Text: We'll live here and meet with clients.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u0422\u0443\u0442 \u0436\u0438\u0442\u0438\u043C\u0435\u043C\u043E \u0439
      \u043F\u0440\u0438\u0439\u043C\u0430\u0442\u0438\u043C\u0435\u043C\u043E \u0437\u0430\u043C\u043E\u0432\u043D\u0438\u043A\u0456\u0432."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Aqu\xED viviremos y recibiremos a los clientes."
    Object: {fileID: 0}
