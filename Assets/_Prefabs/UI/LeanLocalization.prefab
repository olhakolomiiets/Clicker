--- !u!114 &4425349728510943245
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1989134682707317259}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: LeanLocalization::Lean.Localization.LeanPhrase
  data: 0
  entries:
  - Language: Russian
    Text: "\u041A\u0430\u043A\u043E\u0439-\u0442\u043E \u0440\u043E\u0431\u043E\u0442
      \u0437\u0430\u043A\u0430\u0437\u0430\u043B \u0441\u0435\u0431\u0435 \u043F\u043B\u0430\u043D\u0435\u0442\u0443.
      \u0425\u043E\u0447\u0435\u0442, \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u0441\u0442\u043D\u044B\u0435
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u043B\u0438 \u0435\u043C\u0443
      \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438."
    Object: {fileID: 0}
  - Language: English
    Text: Some robot ordered a planet. He wants the locals to make spare parts for
      him.
    Object: {fileID: 0}
  - Language: Ukrainian
    Text: "\u042F\u043A\u0438\u0439\u0441\u044C \u0440\u043E\u0431\u043E\u0442 \u0437\u0430\u043C\u043E\u0432\u0438\u0432
      \u0441\u043E\u0431\u0456 \u043F\u043B\u0430\u043D\u0435\u0442\u0443. \u0425\u043E\u0447\u0435,
      \u0449\u043E\u0431 \u043C\u0456\u0441\u0446\u0435\u0432\u0456 \u0432\u0438\u0440\u043E\u0431\u043B\u044F\u043B\u0438
      \u0434\u043B\u044F \u043D\u044C\u043E\u0433\u043E \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438\u043D\u0438."
    Object: {fileID: 0}
  - Language: Spanish
    Text: "Un robot ha encargado un planeta. Quiere que sus habitantes fabriquen
      piezas de repuesto para \xE9l."
    Object: {fileID: 0}
