{
  "format_version": 1,
  "project_name": "Planet Builder",
  "automation_stage": "BOOTSTRAP-03B-2A",
  "dry_run_default": true,
  "paths": {
    "automation_root": "CodexAutomation",
    "runtime_root": "CodexAutomation/runtime",
    "logs_root": "CodexAutomation/runtime/logs",
    "reports_root": "CodexAutomation/runtime/reports",
    "results_root": "CodexAutomation/runtime/results",
    "prompts_root": "CodexAutomation/prompts",
    "schemas_root": "CodexAutomation/schemas",
    "tasks_root": "CodexAutomation/tasks"
  },
  "tools": {
    "python_command": "python",
    "git_command": "git",
    "codex_commands": [
      "codex.cmd",
      "codex"
    ]
  },
  "codex_runner": {
    "commands": [
      "codex.cmd",
      "codex"
    ],
    "project_working_directory": ".",
    "smoke_test_timeout_seconds": 180,
    "safe_mode": "read_only",
    "test_task_id": "TEST-001"
  },
  "pipeline": {
    "maxRepairAttemptsDefault": 3,
    "pipelineSelfTestEnabled": true,
    "runtimeWorkspaceRoot": "CodexAutomation/runtime/workspaces",
    "pipelineReportRoot": "CodexAutomation/runtime/pipeline_runs",
    "allowRealWorkspaceWrite": false,
    "maxCodexInvocationsPerPipelineRun": 20,
    "reserveInvocationsForFinalAudit": 2,
    "maxAuditsPerTask": 4
  },
  "usageLimits": {
    "enabled": true,
    "maxRateLimitRetriesPerInvocation": 1,
    "resetSafetyBufferSeconds": 60,
    "maximumWaitSeconds": 7200,
    "stopWhenResetTimeUnknown": true,
    "allowAutomaticCreditUsage": false,
    "allowAutomaticModelDowngrade": false
  },
  "realRoles": {
    "enabled": true,
    "allowRealProjectWrite": false,
    "allowIsolatedWorkspaceWriteTest": true,
    "isolatedWorkspaceRoot": "CodexAutomation/runtime/real_role_workspaces",
    "realRoleReportRoot": "CodexAutomation/runtime/real_role_runs",
    "maxRealCodexInvocationsPerTest": 3,
    "implementerTimeoutSeconds": 600,
    "repairerTimeoutSeconds": 600,
    "auditorTimeoutSeconds": 600,
    "sandboxProbeTimeoutSeconds": 30,
    "sandboxProbeTaskkillTimeoutSeconds": 10,
    "sandboxProbePostKillWaitSeconds": 5,
    "approvalPolicy": "never",
    "windowsSandboxImplementation": "elevated",
    "requireSandboxWriteProbe": true,
    "allowAutomaticUnelevatedFallback": false,
    "useJsonEvents": true,
    "useOutputSchema": true,
    "useOutputLastMessage": true,
    "automaticRetryAfterRateLimit": false
  },
  "realTasks": {
    "allowExecution": false,
    "allowParentProjectWrite": false,
    "allowAutomaticApply": false,
    "allowNetwork": false,
    "allowPackageInstall": false,
    "allowUnityLaunch": false,
    "allowAutomaticRetry": false,
    "allowAutomaticModelDowngrade": false,
    "allowAutomaticCreditUsage": false,
    "allowDirtyParentWorktree": true,
    "allowBinaryOutputs": false,
    "maxInvocations": 3,
    "maxRepairAttempts": 1,
    "maxChangedFiles": 50,
    "maxChangedBytes": 10485760,
    "maxSingleChangedFileBytes": 2097152,
    "maxSourceFiles": 2000,
    "maxSourceBytes": 104857600,
    "allowedSourceRoots": [
      "Assets",
      "Packages",
      "ProjectSettings"
    ],
    "forbiddenSourceRoots": [
      ".git",
      ".codex",
      "CodexAutomation",
      "Library",
      "Temp",
      "Logs",
      "obj",
      "Build",
      "Builds",
      "UserSettings"
    ],
    "allowedTaskTypes": [
      "isolated_code_change"
    ],
    "allowedValidatorTypes": [
      "file_exists",
      "file_absent",
      "json_valid",
      "json_schema",
      "json_field_equals",
      "text_contains",
      "text_not_contains",
      "changed_paths_exact",
      "changed_paths_subset",
      "no_unexpected_files",
      "no_conflict_markers",
      "max_file_size",
      "max_changed_files",
      "extension_allowlist"
    ]
  },
  "unity": {
    "project_version_file": "ProjectSettings/ProjectVersion.txt",
    "hub_editor_root": "C:/Program Files/Unity/Hub/Editor"
  }
}
