        "parentHead": { "type": ["string", "null"] }
      }
    },
    "parentHead": { "type": ["string", "null"] },
    "parentGitSnapshotHash": { "type": "string" },
    "manifestSha256": { "type": "string" },
    "effectivePolicyHash": { "type": "string" },
