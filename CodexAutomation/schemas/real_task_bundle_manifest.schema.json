    "foundationFinalReportHash": { "type": "string" },
    "finalChangeAnalysisReportHash": { "type": "string" },
    "finalValidationReportHash": { "type": "string" },
    "auditReportHash": { "type": "string" },
    "changedPathCount": { "type": "integer" },
    "deletedPathCount": { "type": "integer" },
    "copiedFileCount": { "type": "integer" },
    "totalBundleBytes": { "type": "integer" },
