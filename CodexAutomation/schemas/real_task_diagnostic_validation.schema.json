{
  "type": "object",
  "required": ["reportVersion", "orchestrationRunId", "taskId", "stage", "authorization", "attemptNumber", "executionContextHash", "originalBaselineHash", "changeBaselineInventoryHash", "diagnosticFinalInventoryHash", "diagnosticDiffHash", "diagnosticPolicyHash", "validatorResultHash", "changePolicyVerdict", "validationVerdict", "passCount", "failCount", "blockedCount", "integrityPassed", "repairableFindingCount", "nonRepairableFindingCount", "repairEligible", "repairEligibilityCode", "findingsHash", "diagnosticReportHash", "parentGitChanged", "parentSourceChanged", "serviceFilesValid", "isolatedGitValid", "finalVerdict", "findings", "errorCode", "errorMessage", "durationSeconds"],
  "additionalProperties": false,
  "properties": {
    "reportVersion": { "type": "integer", "const": 1 },
    "orchestrationRunId": { "type": "string" },
    "taskId": { "type": "string" },
    "stage": { "type": "string", "const": "BOOTSTRAP-03B-2C" },
