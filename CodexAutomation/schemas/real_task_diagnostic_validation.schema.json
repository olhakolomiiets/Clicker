    "attemptNumber": { "type": "integer" },
    "executionContextHash": { "type": "string" },
    "originalBaselineHash": { "type": "string" },
    "changeBaselineInventoryHash": { "type": "string" },
    "diagnosticFinalInventoryHash": { "type": "string" },
    "diagnosticDiffHash": { "type": "string" },
    "diagnosticPolicyHash": { "type": "string" },
    "validatorResultHash": { "type": "string" },
    "changePolicyVerdict": { "type": "string" },
    "validationVerdict": { "type": "string" },
    "passCount": { "type": "integer" },
    "failCount": { "type": "integer" },
    "blockedCount": { "type": "integer" },
    "integrityPassed": { "type": "boolean" },
    "repairableFindingCount": { "type": "integer" },
    "nonRepairableFindingCount": { "type": "integer" },
    "repairEligible": { "type": "boolean" },
    "repairEligibilityCode": { "type": "string" },
    "findingsHash": { "type": "string" },
    "diagnosticReportHash": { "type": "string" },
