    "orchestrationRunId": { "type": "string" },
    "taskId": { "type": "string" },
    "stage": { "type": "string", "const": "BOOTSTRAP-03B-2C" },
    "stateHistory": { "type": "array", "items": { "type": "string" } },
    "executionContextHash": { "type": ["string", "null"] },
    "manifestSha256": { "type": ["string", "null"] },
    "effectivePolicyHash": { "type": ["string", "null"] },
    "foundationRunId": { "type": ["string", "null"] },
    "foundationFinalReportHash": { "type": ["string", "null"] },
    "sandboxProbeReportHash": { "type": ["string", "null"] },
    "implementerInvocationReportHash": { "type": ["string", "null"] },
    "diagnosticReportHash": { "type": ["string", "null"] },
    "repairDecisionReportHash": { "type": ["string", "null"] },
    "repairerInvocationReportHash": { "type": ["string", "null"] },
    "finalChangeAnalysisReportHash": { "type": ["string", "null"] },
    "finalValidationReportHash": { "type": ["string", "null"] },
    "auditorInvocationReportHash": { "type": ["string", "null"] },
    "auditReportHash": { "type": ["string", "null"] },
    "resultBundleManifestHash": { "type": ["string", "null"] },
    "invocationBudget": {
      "type": "object",
      "required": ["maxRoleInvocations", "invocationsUsed"],
      "additionalProperties": false,
      "properties": {
        "maxRoleInvocations": { "type": "integer" },
        "invocationsUsed": { "type": "integer" }
      }
    },
    "invocationsUsed": { "type": "integer" },
    "repairBudget": {
      "type": "object",
      "required": ["maxRepairAttempts", "repairsUsed"],
      "additionalProperties": false,
      "properties": {
        "maxRepairAttempts": { "type": "integer" },
        "repairsUsed": { "type": "integer" }
      }
    },
    "repairsUsed": { "type": "integer" },
    "implementerCompleted": { "type": "boolean" },
    "diagnosticVerdict": { "type": ["string", "null"] },
    "repairAttempted": { "type": "boolean" },
    "finalHostValidationPassed": { "type": "boolean" },
    "auditorRan": { "type": "boolean" },
    "auditorApproved": { "type": "boolean" },
    "workspaceUnchangedAfterAuditor": { "type": ["boolean", "null"] },
    "parentGitChanged": { "type": "boolean" },
    "parentSourceChanged": { "type": ["boolean", "null"] },
    "serviceFilesValid": { "type": ["boolean", "null"] },
    "agentsDirectoryValid": { "type": ["boolean", "null"] },
    "isolatedGitValid": { "type": ["boolean", "null"] },
    "bundleIntegrityValid": { "type": "boolean" },
    "codexInvocationCount": { "type": "integer" },
    "modelInvocationStarted": { "type": "boolean" },
    "sandboxStarted": { "type": "boolean" },
    "unityStarted": { "type": "boolean" },
    "networkUsed": { "type": "boolean" },
    "packageInstallUsed": { "type": "boolean" },
    "automaticRetryUsed": { "type": "boolean" },
    "modelDowngradeUsed": { "type": "boolean" },
    "creditUsageTriggered": { "type": "boolean" },
    "durationSeconds": { "type": "number" },
    "finalState": { "type": "string" },
    "finalVerdict": { "type": "string" },
    "errorCode": { "type": ["string", "null"] },
    "errorMessage": { "type": ["string", "null"] },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": ["string", "null"] }
        }
      }
    }
  }
