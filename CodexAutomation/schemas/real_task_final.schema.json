    "orchestrationRunId",
    "taskId",
    "stage",
    "stateHistory",
    "executionContextHash",
    "manifestSha256",
    "effectivePolicyHash",
    "foundationRunId",
    "foundationFinalReportHash",
    "sandboxProbeReportHash",
    "implementerInvocationReportHash",
    "diagnosticReportHash",
    "repairDecisionReportHash",
    "repairerInvocationReportHash",
    "finalChangeAnalysisReportHash",
    "finalValidationReportHash",
    "auditorInvocationReportHash",
    "auditReportHash",
    "resultBundleManifestHash",
    "invocationBudget",
    "invocationsUsed",
    "repairBudget",
    "repairsUsed",
    "implementerCompleted",
    "diagnosticVerdict",
    "repairAttempted",
    "finalHostValidationPassed",
    "auditorRan",
    "auditorApproved",
    "workspaceUnchangedAfterAuditor",
    "parentGitChanged",
