{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "objective",
    "taskType",
    "sourcePaths",
    "allowedWritePaths",
    "expectedOutputs",
    "validationPlan",
    "completionCriteria"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "taskId": { "type": "string" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "taskType": { "type": "string", "enum": ["isolated_code_change"] },
    "sourcePaths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowedWritePaths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowedDeletePaths": { "type": "array", "items": { "type": "string" } },
    "expectedOutputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "required"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string", "enum": ["file", "directory"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "validationPlan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object"
      }
    },
    "completionCriteria": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 30 },
    "roleBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxInvocations": { "type": "integer" }
      }
    },
    "repairPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxChangedFiles": { "type": "integer" },
        "maxChangedBytes": { "type": "integer" },
        "maxSingleChangedFileBytes": { "type": "integer" }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
