                  "properties": {
                    "command": { "type": "array", "items": { "type": "string" } },
                    "exitCode": { "type": ["integer", "null"] },
                    "success": { "type": "boolean" },
                    "stderr": { "type": "string" },
                    "failure": { "type": ["string", "null"] }
                  }
                },
                "porcelainStatus": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["command", "exitCode", "success", "stderr", "failure"],
                  "properties": {
                    "command": { "type": "array", "items": { "type": "string" } },
                    "exitCode": { "type": ["integer", "null"] },
                    "success": { "type": "boolean" },
                    "stderr": { "type": "string" },
                    "failure": { "type": ["string", "null"] }
                  }
                },
                "branch": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["command", "exitCode", "success", "stderr", "failure"],
                  "properties": {
                    "command": { "type": "array", "items": { "type": "string" } },
                    "exitCode": { "type": ["integer", "null"] },
                    "success": { "type": "boolean" },
                    "stderr": { "type": "string" },
                    "failure": { "type": ["string", "null"] }
                  }
                },
                "head": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["command", "exitCode", "success", "stderr", "failure"],
                  "properties": {
                    "command": { "type": "array", "items": { "type": "string" } },
                    "exitCode": { "type": ["integer", "null"] },
                    "success": { "type": "boolean" },
                    "stderr": { "type": "string" },
                    "failure": { "type": ["string", "null"] }
                  }
                },
                "stagedPaths": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["command", "exitCode", "success", "stderr", "failure"],
                  "properties": {
                    "command": { "type": "array", "items": { "type": "string" } },
                    "exitCode": { "type": ["integer", "null"] },
                    "success": { "type": "boolean" },
                    "stderr": { "type": "string" },
                    "failure": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        },
        "finalVerdict": { "type": "string", "enum": ["PASS", "BLOCKED"] },
        "errorCode": { "type": ["string", "null"] },
        "errorMessage": { "type": ["string", "null"] }
      }
    },
    "codexInvocationCount": { "type": "integer" },
    "modelInvocationStarted": { "type": "boolean" },
    "sandboxStarted": { "type": "boolean" },
    "unityStarted": { "type": "boolean" },
    "networkUsed": { "type": "boolean" },
    "durationSeconds": { "type": "number" },
    "finalState": { "type": "string", "enum": ["COMPLETED", "FAILED", "BLOCKED"] },
    "finalVerdict": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED"] },
    "errorCode": { "type": ["string", "null"] },
    "errorMessage": { "type": ["string", "null"] },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
