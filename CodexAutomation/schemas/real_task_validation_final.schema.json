      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resultVersion", "validatorId", "validatorIndex", "validatorType", "validatorVersion", "status", "code", "message", "primaryPath", "relatedPaths", "expected", "actual", "filesRead", "bytesRead", "durationMilliseconds", "noSideEffects", "findings"],
