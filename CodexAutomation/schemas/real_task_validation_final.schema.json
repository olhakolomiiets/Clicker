              "implementationId": { "type": "string" },
              "argumentContract": { "type": "string" },
              "needsWorkspaceRead": { "type": "boolean" },
              "needsDiff": { "type": "boolean" },
              "needsExpectedOutputs": { "type": "boolean" },
              "maxFilesRead": { "type": "integer" },
              "allowedFailCodes": { "type": "array", "items": { "type": "string" } },
              "noSideEffects": { "type": "boolean" }
            }
          }
        },
        "registrySha256": { "type": "string" }
      }
    },
    "schemaRegistry": {
      "type": "object",
      "additionalProperties": false,
