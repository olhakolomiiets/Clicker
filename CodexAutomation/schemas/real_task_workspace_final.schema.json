{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportVersion",
    "runId",
    "taskId",
    "stage",
    "stateHistory",
    "manifestSha256",
    "trustedContextHash",
    "parentGitInitialSnapshot",
    "parentGitFinalSnapshot",
    "parentGitChanged",
    "sourcePrePostMatch",
    "sourceCopyVerified",
    "workspaceCreated",
    "stagingRetained",
    "workspaceReady",
    "serviceFilesValid",
    "isolatedGitValid",
    "sourceInventoryHash",
    "workspaceBaselineInventoryHash",
    "codexInvocationCount",
    "modelInvocationStarted",
    "sandboxStarted",
    "unityStarted",
    "networkUsed",
    "sourceCopied",
    "complete",
    "finalReportRelativePath",
    "finalReportReceipt",
    "durationSeconds",
    "finalState",
    "finalVerdict",
    "errorCode",
    "errorMessage",
    "warnings"
  ],
  "properties": {
    "reportVersion": { "type": "integer", "const": 1 },
    "runId": { "type": "string" },
    "taskId": { "type": "string" },
    "stage": { "type": "string", "const": "BOOTSTRAP-03B-2B-A" },
    "stateHistory": { "type": "array", "items": { "type": "string" } },
    "manifestSha256": { "type": ["string", "null"] },
    "trustedContextHash": { "type": ["string", "null"] },
    "parentGitInitialSnapshot": { "type": ["object", "null"], "additionalProperties": true },
    "parentGitFinalSnapshot": { "type": ["object", "null"], "additionalProperties": true },
    "parentGitChanged": { "type": ["boolean", "null"] },
    "sourcePrePostMatch": { "type": "boolean" },
    "sourceCopyVerified": { "type": "boolean" },
    "workspaceCreated": { "type": "boolean" },
    "stagingRetained": { "type": "boolean" },
    "workspaceReady": { "type": "boolean" },
    "serviceFilesValid": { "type": "boolean" },
    "isolatedGitValid": { "type": "boolean" },
    "sourceInventoryHash": { "type": ["string", "null"] },
    "workspaceBaselineInventoryHash": { "type": ["string", "null"] },
    "codexInvocationCount": { "type": "integer", "const": 0 },
    "modelInvocationStarted": { "type": "boolean", "const": false },
    "sandboxStarted": { "type": "boolean", "const": false },
    "unityStarted": { "type": "boolean", "const": false },
    "networkUsed": { "type": "boolean", "const": false },
    "sourceCopied": { "type": "boolean" },
    "complete": { "type": "boolean" },
    "finalReportRelativePath": { "type": ["string", "null"] },
    "finalReportReceipt": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["relativePath", "size", "sha256", "schemaName", "reportVersion"],
      "properties": {
        "relativePath": { "type": "string" },
        "size": { "type": "integer" },
        "sha256": { "type": "string" },
        "schemaName": { "type": "string", "const": "real_task_workspace_final.schema.json" },
        "reportVersion": { "type": "integer", "const": 1 }
      }
    },
    "durationSeconds": { "type": "number" },
    "finalState": { "type": "string" },
    "finalVerdict": { "type": "string", "enum": ["PASS", "FAILED", "BLOCKED"] },
    "errorCode": { "type": ["string", "null"] },
    "errorMessage": { "type": ["string", "null"] },
    "warnings": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  }
}
