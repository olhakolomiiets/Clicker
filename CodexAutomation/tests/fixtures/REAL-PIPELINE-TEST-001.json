    "artifact.json has no additional fields",
    "Only artifact.json changes after workspace initialization"
  ],
  "allowedWritePaths": [
    "artifact.json"
  ],
  "forbiddenWritePaths": [
    "../*",
    "Assets/**",
    "Packages/**",
    "ProjectSettings/**",
    "CodexAutomation/**"
  ],
  "maxRepairAttempts": 0,
  "validations": [
    {
      "type": "required_file",
      "code": "ARTIFACT_REQUIRED",
      "file": "artifact.json"
    },
    {
      "type": "json_valid",
      "code": "ARTIFACT_JSON_VALID",
      "file": "artifact.json"
    },
    {
      "type": "json_field_equals",
      "code": "ARTIFACT_TASK_ID_INCORRECT",
      "file": "artifact.json",
      "field": "taskId",
      "expected": "REAL-PIPELINE-TEST-001"
    },
    {
      "type": "json_field_equals",
      "code": "ARTIFACT_VALUE_INCORRECT",
      "file": "artifact.json",
      "field": "value",
      "expected": 42
    },
    {
      "type": "json_field_equals",
      "code": "REPAIR_NOT_APPLIED",
      "file": "artifact.json",
      "field": "repairApplied",
      "expected": true
    },
    {
      "type": "exact_allowed_changed_paths",
      "code": "CHANGED_PATHS_EXACT",
      "paths": [
        "artifact.json"
      ]
    },
    {
      "type": "no_unexpected_files",
