{
  "id": "REAL-PIPELINE-TEST-001",
  "title": "Isolated real Codex role pipeline self-test",
  "description": "A runtime-only isolated workspace test for real implementer, repairer, and read-only auditor roles.",
  "mode": "pipeline_fake_test",
  "initialImplementationInstructions": "Create artifact.json in the controlled pre-repair state only.",
  "acceptanceCriteria": [
    "artifact.json exists",
    "artifact.json is valid JSON",
    "artifact.json taskId is REAL-PIPELINE-TEST-001",
